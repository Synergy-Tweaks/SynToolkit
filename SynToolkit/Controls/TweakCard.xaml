<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SynToolkit.Controls.TweakCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SynToolkit.Views"
    xmlns:viewmodels="using:SynToolkit.ViewModels"
    x:Name="Root">

    <UserControl.Resources>
        <views:NvidiaStatusToBrushConverter x:Key="NvidiaStatusToBrushConverter" />
        <views:NvidiaRiskToBrushConverter x:Key="NvidiaRiskToBrushConverter" />
        <views:NvidiaCurrentValueBrushConverter x:Key="NvidiaCurrentValueBrushConverter" />
        <views:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <views:NvidiaActiveToBorderBrushConverter x:Key="NvidiaActiveToBorderBrushConverter" />
    </UserControl.Resources>

    <Border
        Padding="12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{x:Bind Item.IsActive, Mode=OneWay, Converter={StaticResource NvidiaActiveToBorderBrushConverter}}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{x:Bind Item.Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Border
                    Grid.Column="1"
                    Padding="8,2"
                    Background="{x:Bind Item.Risk, Converter={StaticResource NvidiaRiskToBrushConverter}}"
                    CornerRadius="10">
                    <TextBlock FontSize="11" Text="{x:Bind Item.RiskText, Mode=OneWay}" />
                </Border>
                <!--  Active: accent badge, same look as the active power plan.  -->
                <Border
                    Grid.Column="2"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="10"
                    Visibility="{x:Bind Item.IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="Active" />
                </Border>
                <!--  Any other state (Not set, Different, Partial, Restart pending).  -->
                <Border
                    Grid.Column="2"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{x:Bind Item.StatusText, Mode=OneWay, Converter={StaticResource NvidiaStatusToBrushConverter}}"
                    CornerRadius="10"
                    Visibility="{x:Bind Item.IsNotActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock FontSize="11" Text="{x:Bind Item.StatusText, Mode=OneWay}" />
                </Border>
            </Grid>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Item.Description, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                FontFamily="Consolas"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind Item.LocationText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

            <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Item.RecommendedDisplay, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="|" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Current:" />
                <TextBlock
                    FontSize="12"
                    Foreground="{x:Bind Item.StatusText, Mode=OneWay, Converter={StaticResource NvidiaCurrentValueBrushConverter}}"
                    Text="{x:Bind Item.CurrentValueText, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    AutomationProperties.Name="Apply tweak"
                    Click="ApplyButton_Click"
                    Content="Apply"
                    IsEnabled="{x:Bind Item.CanWrite, Mode=OneWay}"
                    ToolTipService.ToolTip="Apply the recommended value(s)."
                    Visibility="{x:Bind Item.IsNotActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button
                    AutomationProperties.Name="Revert tweak"
                    Click="RevertButton_Click"
                    Content="Revert"
                    IsEnabled="{x:Bind Item.CanWrite, Mode=OneWay}"
                    ToolTipService.ToolTip="Revert this tweak to original value(s) when available." />
                <DropDownButton
                    AutomationProperties.Name="More tweak actions"
                    Content="..."
                    ToolTipService.ToolTip="More actions">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Click="CheckButton_Click"
                                Text="Check" />
                            <MenuFlyoutItem
                                Click="CustomValueButton_Click"
                                Text="Custom value..."
                                Visibility="{x:Bind Item.SupportsCustomValue, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                            <MenuFlyoutItem
                                Click="CopyPathButton_Click"
                                Text="Copy registry path" />
                            <MenuFlyoutItem
                                Click="OpenRegeditButton_Click"
                                Text="Open in Regedit" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
