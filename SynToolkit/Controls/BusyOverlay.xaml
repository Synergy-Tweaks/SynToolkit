<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SynToolkit.Controls.BusyOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SynToolkit.Views"
    x:Name="OverlayRoot"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid
        Background="#99000000"
        IsHitTestVisible="True"
        Visibility="{Binding ShowWhen, ElementName=OverlayRoot, Converter={StaticResource BoolToVisibilityConverter}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressRing Width="36" Height="36" IsActive="True" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="{Binding BusyText}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
