<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Name="RootPage"
    x:Class="SynToolkit.Views.UninstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SynToolkit.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:SynToolkit.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:UninstallerPageViewModel}"
    Loaded="Page_Loaded"
    NavigationCacheMode="Disabled"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToSeverityConverter x:Key="BoolToSeverityConverter" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter" />
        <local:StringNullOrWhitespaceToVisibilityConverter x:Key="StringNullOrWhitespaceToVisibilityConverter" />
        <local:SelectedToBorderBrushConverter x:Key="SelectedToBorderBrushConverter" />
        <local:SelectedToBackgroundConverter x:Key="SelectedToBackgroundConverter" />
    </Page.Resources>

    <Grid Margin="36,0,36,24" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,24,0,0" Spacing="8">
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Uninstaller" local:LocalizedText.TextKey="UninstallerPageTitle" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Scan every installed desktop app and remove it with its own uninstaller." local:LocalizedText.TextKey="UninstallerPageDescription"
                TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            IsClosable="True"
            IsOpen="{Binding HasError, Mode=OneWay}"
            Message="{Binding StatusMessage, Mode=OneWay}"
            Severity="Error"
            Title="Uninstaller" local:LocalizedText.TitleKey="UninstallerPageErrorTitle" />

        <controls:SettingsCard
            Grid.Row="2"
            Description="Reads installed Win32 + Appx packages and prepares each app's uninstall command." 
            Header="Installed apps"
            local:LocalizedText.HeaderKey="UninstallerPageScan">
            <controls:SettingsCard.HeaderIcon>
                <ImageIcon Source="ms-appx:///assets/Icons/Uninstall.png" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    Click="ScanButton_Click"
                    Content="Scan" local:LocalizedText.ContentKey="UninstallerPageScanButton"
                    IsEnabled="{Binding CanEditSelection, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
                <ProgressRing
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    IsActive="{Binding IsScanning, Mode=OneWay}"
                    Visibility="{Binding IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding CountText, Mode=OneWay}" />
            </StackPanel>
        </controls:SettingsCard>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                PlaceholderText="Search apps"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                local:LocalizedText.PlaceholderTextKey="UninstallerPageSearchPlaceholder"
                IsEnabled="{Binding CanEditSelection, Mode=OneWay}" />
            <CheckBox
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Content="Select all"
                IsChecked="{Binding SelectAllFilteredState, Mode=TwoWay}"
                IsEnabled="{Binding CanEditSelection, Mode=OneWay}"
                IsThreeState="True" />
            <TextBlock
                Grid.Column="2"
                Margin="14,0,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding SelectedCountText, Mode=OneWay}" />
            <Button
                Grid.Column="3"
                Margin="14,0,0,0"
                Click="UninstallSelectedButton_Click"
                Content="Uninstall Selected"
                IsEnabled="{Binding CanUninstallSelected, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <Border
            Grid.Row="4"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8"
            Visibility="{Binding IsProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding QueueStatusText, Mode=OneWay}" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar
                        Minimum="0"
                        Maximum="{Binding QueueProgressMaximum, Mode=OneWay}"
                        Value="{Binding QueueProgressValue, Mode=OneWay}" />
                    <Button
                        Grid.Column="1"
                        Click="CancelQueueButton_Click"
                        Content="Cancel"
                        IsEnabled="{Binding IsUninstallQueueRunning, Mode=OneWay}" />
                </Grid>
            </StackPanel>
        </Border>

        <InfoBar
            Grid.Row="5"
            IsClosable="True"
            IsOpen="{Binding HasQueueSummary, Mode=OneWay}"
            Message="{Binding QueueSummaryText, Mode=OneWay}"
            Severity="{Binding QueueSummaryHasFailures, Mode=OneWay, Converter={StaticResource BoolToSeverityConverter}}"
            Title="Uninstall summary" />

        <TextBlock
            Grid.Row="6"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No apps scanned yet. Press Scan to list everything installed on this PC."
            Visibility="{Binding HasScanned, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverseConverter}}"
            local:LocalizedText.TextKey="UninstallerPageEmptyHint" />

        <ScrollViewer
            Grid.Row="7"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            Visibility="{Binding HasScanned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsRepeater ItemsSource="{Binding FilteredApps, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="12"
                        MinItemWidth="380"
                        MinRowSpacing="12"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="viewmodel:InstalledAppItemViewModel">
                        <Border
                            Height="82"
                            Margin="0"
                            Padding="12,10"
                            Background="{Binding IsSelected, Converter={StaticResource SelectedToBackgroundConverter}}"
                            BorderBrush="{Binding IsSelected, Converter={StaticResource SelectedToBorderBrushConverter}}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Tapped="AppCard_Tapped">
                            <Grid ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    MinWidth="0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="AppSelectionCheckBox_Click"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                    IsEnabled="{Binding DataContext.CanEditSelection, ElementName=RootPage, Mode=OneWay}" />

                                <Border
                                    Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    Margin="12,0,12,0"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="6"
                                    VerticalAlignment="Center">
                                    <Grid>
                                        <Image
                                            Width="36"
                                            Height="36"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{x:Bind Icon, Mode=OneWay}"
                                            Stretch="Uniform"
                                            Visibility="{x:Bind HasCustomIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="16"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE71D;"
                                            Visibility="{x:Bind HasCustomIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        MaxLines="1"
                                        Text="{x:Bind DisplayName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="1"
                                        Text="{x:Bind Publisher, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding Publisher, Converter={StaticResource StringNullOrWhitespaceToVisibilityConverter}}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        MaxLines="1"
                                        Text="{x:Bind DisplayVersion, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding DisplayVersion, Converter={StaticResource StringNullOrWhitespaceToVisibilityConverter}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4">
                                    <Border
                                        Padding="8,2"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        CornerRadius="10"
                                        HorizontalAlignment="Right">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind KindLabel, Mode=OneWay}" />
                                    </Border>
                                    <ProgressRing
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Right"
                                        IsActive="{x:Bind ShowProgress, Mode=OneWay}"
                                        Visibility="{x:Bind ShowProgress, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Right"
                                        MaxLines="1"
                                        Text="{x:Bind StatusText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind ShowStatusText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
