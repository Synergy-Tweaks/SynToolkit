<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.UninstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SynToolkit.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:SynToolkit.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:UninstallerPageViewModel}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="55,0,0,48">
            <TextBlock
                Margin="0,24,36,8"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Uninstaller" local:LocalizedText.TextKey="UninstallerPageTitle" />
            <TextBlock
                Margin="0,0,36,24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Scan every installed desktop app and remove it with its own uninstaller." local:LocalizedText.TextKey="UninstallerPageDescription"
                TextWrapping="Wrap" />

            <InfoBar
                Margin="0,0,36,18"
                IsClosable="True"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding StatusMessage, Mode=OneWay}"
                Severity="Error"
                Title="Uninstaller" local:LocalizedText.TitleKey="UninstallerPageErrorTitle" />

            <controls:SettingsCard
                Margin="0,0,36,16"
                Description="Reads the Windows uninstall registry (machine + current user, 64-bit + 32-bit)." local:LocalizedText.DescriptionKey="UninstallerPageScanDescription"
                Header="Installed apps" local:LocalizedText.HeaderKey="UninstallerPageScan">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Source="ms-appx:///assets/Icons/Uninstall.png" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        x:Name="ScanButton"
                        Click="ScanButton_Click"
                        Content="Scan" local:LocalizedText.ContentKey="UninstallerPageScanButton"
                        Style="{StaticResource AccentButtonStyle}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        IsActive="{Binding IsScanning, Mode=OneWay}"
                        Visibility="{Binding IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </controls:SettingsCard>

            <Grid Margin="0,0,36,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    PlaceholderText="Search apps" local:LocalizedText.PlaceholderTextKey="UninstallerPageSearchPlaceholder"
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding CountText, Mode=OneWay}" />
            </Grid>

            <TextBlock
                Margin="0,0,36,24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No apps scanned yet. Press Scan to list everything installed on this PC." local:LocalizedText.TextKey="UninstallerPageEmptyHint"
                Visibility="{Binding HasScanned, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverseConverter}}" />

            <ItemsControl
                Margin="0,0,36,0"
                ItemsSource="{Binding FilteredApps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodel:InstalledAppItemViewModel">
                        <controls:SettingsCard Margin="0,0,0,8" Description="{x:Bind DetailsText, Mode=OneWay}">
                            <controls:SettingsCard.Header>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Image
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Center"
                                        Source="{x:Bind Icon, Mode=OneWay}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{x:Bind DisplayName, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </controls:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    IsActive="{x:Bind IsUninstalling, Mode=OneWay}"
                                    Visibility="{x:Bind IsUninstalling, Mode=OneWay}" />
                                <Button
                                    Click="UninstallButton_Click"
                                    Content="Uninstall"
                                    IsEnabled="{x:Bind CanUninstall, Mode=OneWay}" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
