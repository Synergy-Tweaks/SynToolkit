<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.AudioMixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SynToolkit.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:SynToolkit.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:AudioMixerPageViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,10" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="55,0,0,48">
            <TextBlock
                Margin="0,24,36,8"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Audio Mixer"
                local:LocalizedText.TextKey="AudioMixerPage_Title" />
            <TextBlock
                Margin="0,0,36,18"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Adjust the master output level, choose a default level for new audio apps, and fine-tune individual app volumes while they are running."
                TextWrapping="Wrap"
                local:LocalizedText.TextKey="AudioMixerPage_Description" />

            <InfoBar
                x:Name="TipsInfoBar"
                Margin="0,0,36,18"
                IsClosable="True"
                IsOpen="{Binding IsTipsOpen, Mode=TwoWay}"
                Closed="TipsInfoBar_Closed"
                Message="{Binding TipsMessage, Mode=OneWay}"
                Severity="Informational"
                Title="Quick tip"
                local:LocalizedText.TitleKey="AudioMixerPage_QuickTip" />

            <InfoBar
                Margin="0,0,36,18"
                IsClosable="True"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Title="Audio Mixer"
                local:LocalizedText.TitleKey="AudioMixerPage_Title" />

            <TextBlock
                Style="{StaticResource SectionTitle}"
                Text="Now Playing"
                local:LocalizedText.TextKey="AudioMixerPage_NowPlaying" />

            <Border
                Margin="0,0,36,18"
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Width="640" Spacing="14">
                    <Grid
                        ColumnSpacing="16"
                        Visibility="{Binding HasMediaSession, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="132"
                            Height="132"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="12">
                            <Grid>
                                <Image
                                    Source="{Binding SelectedMediaSession.ThumbnailSource, Mode=OneWay}"
                                    Stretch="UniformToFill"
                                    Visibility="{Binding SelectedMediaSession.HasThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    Glyph="&#xE189;"
                                    Visibility="{Binding SelectedMediaSession.HasThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Grid Width="28" Height="28">
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="14" />
                                        <Image
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            Source="{Binding SelectedMediaSession.AppIconSource, Mode=OneWay}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding SelectedMediaSession.HasAppIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Text="{Binding SelectedMediaSession.SourceBadgeText, Mode=OneWay}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding SelectedMediaSession.HasAppIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
                                    </Grid>
                                    <StackPanel Spacing="1">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{Binding SelectedMediaSession.SourceAppName, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding SelectedMediaSession.SessionSummary, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    MaxLines="2"
                                    Text="{Binding SelectedMediaSession.Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="2"
                                    Text="{Binding SelectedMediaSession.Subtitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    x:Name="PreviousTrackButton"
                                    Command="{Binding SkipPreviousCommand}"
                                    IsEnabled="{Binding CanSkipPrevious, Mode=OneWay}"
                                    ToolTipService.ToolTip="Previous track">
                                    <FontIcon FontSize="16" Glyph="&#xE892;" />
                                </Button>
                                <Button
                                    Command="{Binding TogglePlaybackCommand}"
                                    IsEnabled="{Binding CanTogglePlayback, Mode=OneWay}"
                                    ToolTipService.ToolTip="{Binding PlayPauseText, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="{Binding PlayPauseGlyph, Mode=OneWay}" />
                                </Button>
                                <Button
                                    x:Name="NextTrackButton"
                                    Command="{Binding SkipNextCommand}"
                                    IsEnabled="{Binding CanSkipNext, Mode=OneWay}"
                                    ToolTipService.ToolTip="Next track">
                                    <FontIcon FontSize="16" Glyph="&#xE893;" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        Margin="0,2,0,0"
                        Spacing="4"
                        VerticalAlignment="Top"
                        Visibility="{Binding HasMediaSession, Converter={StaticResource BoolToVisibilityInverseConverter}}">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="Nothing playing right now"
                            local:LocalizedText.TextKey="AudioMixerPage_NothingPlayingTitle" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Start playback in any media app and the controls will appear here automatically."
                            TextWrapping="WrapWholeWords"
                            local:LocalizedText.TextKey="AudioMixerPage_NothingPlayingDescription" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock
                Style="{StaticResource SectionTitle}"
                Text="Controls"
                local:LocalizedText.TextKey="AudioMixerPage_Controls" />

            <controls:SettingsCard
                Margin="0,0,36,10"
                Description="Changes the current default playback device volume immediately."
                Header="Master volume"
                Style="{StaticResource ConfigurationSettingsCardTemplate}"
                local:LocalizedText.HeaderKey="AudioMixerPage_MasterVolume"
                local:LocalizedText.DescriptionKey="AudioMixerPage_MasterVolumeDescription">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
                    <Slider
                        Width="260"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding MasterVolume, Mode=TwoWay}" />
                    <TextBlock
                        MinWidth="44"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding MasterVolumeText, Mode=OneWay}" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard
                Margin="0,0,36,10"
                Description="Applied automatically to apps the first time they create an audio session."
                Header="Default volume for new apps"
                Style="{StaticResource ConfigurationSettingsCardTemplate}"
                local:LocalizedText.HeaderKey="AudioMixerPage_DefaultVolume"
                local:LocalizedText.DescriptionKey="AudioMixerPage_DefaultVolumeDescription">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
                    <Slider
                        Width="260"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding DefaultVolume, Mode=TwoWay}" />
                    <TextBlock
                        MinWidth="44"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding DefaultVolumeText, Mode=OneWay}" />
                </StackPanel>
            </controls:SettingsCard>

            <TextBlock
                Style="{StaticResource SectionTitle}"
                Text="Devices"
                local:LocalizedText.TextKey="AudioMixerPage_Devices" />

            <controls:SettingsCard
                Margin="0,0,36,10"
                Description="Plays audio through the selected device."
                Header="Output device"
                Style="{StaticResource ConfigurationSettingsCardTemplate}"
                local:LocalizedText.HeaderKey="AudioMixerPage_OutputDevice"
                local:LocalizedText.DescriptionKey="AudioMixerPage_OutputDeviceDescription">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F5;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox
                    Width="280"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding OutputDevices}"
                    SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Margin="0,0,36,10"
                Description="Records audio from the selected device."
                Header="Input device"
                Style="{StaticResource ConfigurationSettingsCardTemplate}"
                local:LocalizedText.HeaderKey="AudioMixerPage_InputDevice"
                local:LocalizedText.DescriptionKey="AudioMixerPage_InputDeviceDescription">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE720;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox
                    Width="280"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding InputDevices}"
                    SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsExpander
                Margin="0,0,36,18"
                Description="{Binding HotkeySummary, Mode=OneWay}"
                Header="Open Audio Mixer hotkey"
                Style="{StaticResource ConfigurationSettingsExpanderTemplate}"
                local:LocalizedText.HeaderKey="AudioMixerPage_HotkeyHeader">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE765;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Description="When off, the shortcut does not open the mixer."
                        Header="Enable global hotkey"
                        local:LocalizedText.HeaderKey="AudioMixerPage_HotkeyEnabled"
                        local:LocalizedText.DescriptionKey="AudioMixerPage_HotkeyEnabledDescription">
                        <ToggleSwitch IsOn="{Binding HotkeyEnabled, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard IsEnabled="{Binding IsHotkeyShortcutEnabled, Mode=OneWay}">
                        <controls:SettingsCard.Header>
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="Shortcut"
                                        local:LocalizedText.TextKey="AudioMixerPage_Shortcut" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Choose at least one modifier plus a key. The default is Ctrl + Shift + V."
                                        TextWrapping="WrapWholeWords"
                                        local:LocalizedText.TextKey="AudioMixerPage_ShortcutDescription" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox Content="Ctrl" IsChecked="{Binding HotkeyCtrl, Mode=TwoWay}" />
                                    <CheckBox Content="Shift" IsChecked="{Binding HotkeyShift, Mode=TwoWay}" />
                                    <CheckBox Content="Alt" IsChecked="{Binding HotkeyAlt, Mode=TwoWay}" />
                                    <CheckBox Content="Win" IsChecked="{Binding HotkeyWin, Mode=TwoWay}" />
                                    <ComboBox
                                        Width="84"
                                        ItemsSource="{Binding HotkeyKeys}"
                                        SelectedItem="{Binding SelectedHotkeyKey, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </controls:SettingsCard.Header>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <TextBlock
                Style="{StaticResource SectionTitle}"
                Text="Apps"
                local:LocalizedText.TextKey="AudioMixerPage_Apps" />

            <TextBlock
                Margin="0,0,36,18"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Move a slider to update the app instantly. Adjusted apps are remembered automatically and restored the next time they play audio."
                TextWrapping="Wrap"
                local:LocalizedText.TextKey="AudioMixerPage_AppsDescription" />

            <TextBlock
                Margin="0,0,36,18"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No active or remembered audio sessions yet. Start playback in an app, then return here."
                Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibilityInverseConverter}}"
                local:LocalizedText.TextKey="AudioMixerPage_NoSessions" />

            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodel:AudioMixerSessionViewModel">
                        <controls:SettingsCard
                            Margin="0,0,36,8"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <controls:SettingsCard.Header>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid Width="32" Height="32">
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="16" />
                                        <Image
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            Source="{Binding IconSource}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Glyph="&#xE7F5;"
                                            Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding StatusText}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </StackPanel>
                            </controls:SettingsCard.Header>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">
                                <Slider
                                    Width="240"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{Binding Volume, Mode=TwoWay}" />
                                <TextBlock
                                    MinWidth="44"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding VolumeText}" />
                                <Button
                                    Command="{Binding ForgetCommand}"
                                    Content="Forget"
                                    Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibilityConverter}}"
                                    local:LocalizedText.ContentKey="AudioMixerPage_Forget" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
