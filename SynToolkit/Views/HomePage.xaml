<Page
    x:Class="SynToolkit.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:SynToolkit.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SynToolkit.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:SynToolkit.Models"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewmodel="using:SynToolkit.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:HomePageViewModel}"
    mc:Ignorable="d">
    <Page.Resources>
        <local:FontIconConverter x:Key="FontIconConverter" />
    </Page.Resources>
    <ScrollViewer>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.6*" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <GridView
                x:Name="itemGridView"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="-40,-50,0,0"
                HorizontalAlignment="Center"
                IsItemClickEnabled="True"
                IsSwipeEnabled="False"
                SelectionMode="None">
                <GridView.Header>
                    <Grid x:Name="HeaderGrid" Margin="0,50,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="204" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <controls:HomePageHeaderImage
                            Grid.RowSpan="2"
                            Height="396"
                            VerticalAlignment="Top" />

                        <StackPanel
                            Margin="75,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Vertical">

                            <TextBlock
                                x:Name="subHeaderBlock"
                                FontSize="18"
                                Text="SynToolkit" />
                            <TextBlock
                                x:Name="HomeHeaderText"
                                FontSize="45"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="WelcomeText"
                                Margin="2,6,0,0"
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <controls:TileGallery
                            x:Name="headerTileGallery"
                            Grid.Row="1"
                            Margin="40,0,0,0" />
                    </Grid>
                </GridView.Header>
            </GridView>
            <!--  Release Notes Section  -->
            <StackPanel
                x:Name="ReleaseNotesPanel"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="36,5,36,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ReleaseNotesHeader"
                        FontSize="20"
                        Text="What's New in SynergyOS" local:LocalizedText.TextKey="HomePageText3E77C2003BD6" />
                    <HyperlinkButton
                        x:Name="ViewAllReleasesButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="ViewAllReleasesButton_Click"
                        Content="View all releases" local:LocalizedText.ContentKey="HomePageContentB7F2E2F3517E" />
                </Grid>
                <Border
                    Margin="0,10,0,0"
                    Padding="16"
                    Background="{ThemeResource ControlFillColorDefault}"
                    BorderBrush="#15FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <ProgressRing
                            x:Name="ReleaseNotesLoading"
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            IsActive="True"
                            Visibility="Visible" />
                        <StackPanel x:Name="ReleaseNotesContent" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="ReleaseTitle"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="ReleaseDate"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                            <TextBlock
                                x:Name="ReleaseBody"
                                Margin="0,8,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <HyperlinkButton
                                x:Name="ReadMoreButton"
                                Margin="0,4,0,0"
                                Padding="0"
                                Click="ReadMoreButton_Click"
                                Content="Read more" local:LocalizedText.ContentKey="HomePageContent8C338141C3FC" />
                        </StackPanel>
                        <TextBlock
                            x:Name="ReleaseNotesError"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Unable to load release notes." local:LocalizedText.TextKey="HomePageTextD15475C117F4"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel
                x:Name="ProfilesPanel"
                Grid.Row="2"
                Grid.Column="1"
                Margin="16,5,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image
                        Width="24"
                        Height="24"
                        VerticalAlignment="Center"
                        Source="ms-appx:///assets/Icons/UserAccount.png" />
                    <TextBlock x:Name="ProfilesHeader" FontSize="20" VerticalAlignment="Center" />
                </StackPanel>
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="#15FFFFFF" Margin="0,10,36,10">
                    <ListView
                    x:Name="ProfilesListView"
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="225"
                    VerticalAlignment="Top"
                    Background="{ThemeResource ControlFillColorDefault}"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    SelectedItem="{Binding ProfileSelected, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="model:Profiles">
                                <Grid>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout x:Name="MenuFlyout">
                                            <MenuFlyoutItem
                                            x:Name="SetProfile"
                                            Click="SetProfile_Click"
                                            Loaded="SetProfile_Loaded" />
                                            <MenuFlyoutItem
                                            x:Name="DeleteProfile"
                                            Click="DeleteProfile"
                                            Loaded="DeleteProfile_Loaded" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <TextBlock Text="{x:Bind Name}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                <Button
                    x:Name="NewProfileButton"
                    VerticalAlignment="Top"
                    Click="Button_Click" />
                
            </StackPanel>
            <StackPanel
                x:Name="FavoritesSection"
                Grid.Row="2"
                Grid.Column="0"
                Margin="36,5,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image
                        Width="24"
                        Height="24"
                        VerticalAlignment="Center"
                        Source="ms-appx:///assets/Icons/Favorites.png" />
                    <TextBlock x:Name="FavoritesHeader" FontSize="20" VerticalAlignment="Center" />
                </StackPanel>
                <Grid
                    x:Name="FavoritesPanel"
                    MinHeight="300"
                    Margin="0,10,0,0">
                <Grid.Resources>
                    <DataTemplate x:Key="ControlItemTemplate" x:DataType="viewmodel:ConfigurationItemViewModel">
                        <control:SettingsCard
                            x:Name="SettingsCard"
                            Description="{Binding DisplayDescription}"
                            MinHeight="74"
                            Margin="36,0,36,10"
                            Header="{Binding Name}"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <control:SettingsCard.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="MenuFlyoutItem_Click"
                                        Tag="{Binding Key}"
                                        Text="Remove" />
                                </MenuFlyout>
                            </control:SettingsCard.ContextFlyout>
                            <ToggleSwitch
                                x:Name="ConfigSwitch"
                                IsEnabled="{Binding CanInteract}"
                                IsOn="{Binding CurrentSetting}"
                                Loaded="ToggleSwitch_Loaded" />
                        </control:SettingsCard>
                    </DataTemplate>
                    <DataTemplate x:Key="MultiOptionControlTemplate" x:DataType="viewmodel:MultiOptionConfigurationItemViewModel">
                        <control:SettingsCard
                            Height="74"
                            Margin="36,0,36,10"
                            Header="{Binding Name}"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <control:SettingsCard.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="MenuFlyoutItem_Click"
                                        Tag="{Binding Key}"
                                        Text="Remove" />
                                </MenuFlyout>
                            </control:SettingsCard.ContextFlyout>
                            <ComboBox
                                x:Name="ConfigSwitch"
                                Width="200"
                                IsEnabled="{Binding CanInteract}"
                                ItemsSource="{Binding Options}"
                                SelectedItem="{Binding CurrentSetting, Mode=TwoWay}" />
                        </control:SettingsCard>
                    </DataTemplate>
                    <DataTemplate x:Key="ConfigurationButtonTemplate" x:DataType="viewmodel:ConfigurationButtonViewModel">
                        <control:SettingsCard
                            x:Name="SettingsCard"
                            Height="74"
                            Margin="36,0,36,10"
                            Header="{Binding Description}"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <control:SettingsCard.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="MenuFlyoutItem_Click"
                                        Tag="{Binding Key}"
                                        Text="Remove" />
                                </MenuFlyout>
                            </control:SettingsCard.ContextFlyout>
                            <Button
                                Command="{Binding ExecuteCommandCommand}"
                                Content="{Binding Name}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </control:SettingsCard>
                    </DataTemplate>
                    <DataTemplate x:Key="LinksTemplate" x:DataType="viewmodel:LinksViewModel">
                        <control:SettingsCard
                            x:Name="LinkCard"
                            Height="74"
                            Margin="36,0,36,10"
                            ActionIcon="{ui:FontIcon Glyph=&#xE8A7;}"
                            ActionIconToolTip="Open in new window"
                            Click="LinkCard_Click"
                            Header="{Binding Name}"
                            HeaderIcon="{Binding FontIcon, Converter={StaticResource FontIconConverter}}"
                            IsClickEnabled="True"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <control:SettingsCard.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="MenuFlyoutItem_Click"
                                        Tag="{Binding Key}"
                                        Text="Remove" />
                                </MenuFlyout>
                            </control:SettingsCard.ContextFlyout>
                        </control:SettingsCard>
                    </DataTemplate>
                    <local:FavoriteItemDataTemplateSelector
                        x:Key="FavoriteItemDataTemplateSelector"
                        ConfiguartionLink="{StaticResource LinksTemplate}"
                        ConfigurationButton="{StaticResource ConfigurationButtonTemplate}"
                        ConfigurationItem="{StaticResource ControlItemTemplate}"
                        MultiOptionConfigurationItem="{StaticResource MultiOptionControlTemplate}" />
                </Grid.Resources>
                <ItemsControl
                    x:Name="FavoritesControl"
                    ItemTemplateSelector="{StaticResource FavoriteItemDataTemplateSelector}" />
                <TextBlock
                    x:Name="NoFavoritesText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="{StaticResource TextFillColorTertiary}" />
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
