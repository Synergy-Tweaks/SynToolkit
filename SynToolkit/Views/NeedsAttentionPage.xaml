<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.NeedsAttentionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:SynToolkit.Views"
    Loaded="Page_Loaded">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <StackPanel
            Margin="36,28,36,56"
            HorizontalAlignment="Stretch"
            Spacing="18">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    x:Name="AttentionHeaderIcon"
                    Width="44"
                    Height="44"
                    VerticalAlignment="Center"
                    FontSize="32"
                    Foreground="#FFF4B400"
                    Glyph="&#xE7BA;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Text="Needs attention"
                        local:LocalizedText.TextKey="NeedsAttention" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Checks for out-of-date/missing drivers and apps, old SynToolkit version, no restore point, and out-of-sync Windows time."
                        TextWrapping="Wrap"
                        local:LocalizedText.TextKey="NeedsAttention_Subtitle" />
                    <TextBlock
                        x:Name="IgnoredChecksText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Opacity="0.85"
                        Visibility="Collapsed" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="IgnoreOrRestoreButton"
                        Opacity="0.72"
                        Click="IgnoreOrRestoreButton_Click"
                        Content="Ignore All"
                        local:LocalizedText.ContentKey="NeedsAttention_IgnoreAll" />
                    <Button
                        x:Name="RefreshButton"
                        Click="RefreshButton_Click"
                        Content="Refresh"
                        local:LocalizedText.ContentKey="NeedsAttention_Refresh" />
                </StackPanel>
            </Grid>

            <ProgressRing
                x:Name="LoadingRing"
                Width="28"
                Height="28"
                HorizontalAlignment="Center"
                IsActive="True" />

            <InfoBar
                x:Name="ActionInfoBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational" />

            <StackPanel
                x:Name="AllClearPanel"
                Margin="0,72,0,48"
                HorizontalAlignment="Center"
                MaxWidth="320"
                Spacing="12"
                Visibility="Collapsed">
                <Image
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    Source="ms-appx:///assets/Icons/AttentionCheckmark.png"
                    Stretch="Uniform"
                    AutomationProperties.AccessibilityView="Raw" />
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="All clear"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    AutomationProperties.HeadingLevel="Level2"
                    local:LocalizedText.TextKey="NeedsAttention_AllClear" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Check back later."
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    local:LocalizedText.TextKey="NeedsAttention_AllClearDescription" />
            </StackPanel>

            <ItemsControl x:Name="AttentionItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:SettingsCard
                            Margin="0,0,0,10"
                            Description="{Binding Description}"
                            Header="{Binding Title}"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Foreground="#FFF4B400" Glyph="&#xE7BA;" />
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="AttentionActionButton_Click"
                                    Content="{Binding ActionText}"
                                    Tag="{Binding}" />
                                <Button
                                    Click="IgnoreAttentionItemButton_Click"
                                    Content="Ignore"
                                    Tag="{Binding}"
                                    Visibility="{Binding CanIgnore, Converter={StaticResource BoolToVisibilityConverter}}"
                                    local:LocalizedText.ContentKey="NeedsAttention_Ignore" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
