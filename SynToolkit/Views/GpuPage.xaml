<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.GpuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gpu="using:SynToolkit.Models.GpuDrivers"
    xmlns:local="using:SynToolkit.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nvidia="using:SynToolkit.Services.NvidiaProfileInspector"
    xmlns:viewmodel="using:SynToolkit.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:GpuPageViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>
        <Style x:Key="SubGroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>
        <Style x:Key="BreadcrumbTabActive" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="BreadcrumbTabInactive" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="BreadcrumbChevron" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </Page.Resources>

    <Grid Margin="55,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,24,36,8"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Graphics Processing Unit" />
        <StackPanel Grid.Row="1" Margin="0,0,36,18">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Download vendor drivers, slim installation packages, apply NVIDIA profile settings, and remove leftover GPU driver components when needed."
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,6,0,0"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{Binding DetectedGpuSummary}" />
        </StackPanel>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="2"
            Margin="0,0,36,18"
            IsClosable="True"
            IsOpen="{Binding HasError}"
            Message="{Binding StatusMessage}"
            Severity="Error"
            Title="Graphics Processing Unit" />

        <ScrollViewer Grid.Row="3">
            <StackPanel Margin="0,0,36,48">
                <StackPanel x:Name="VendorLandingPanel" Spacing="4">
                    <controls:SettingsCard
                        Click="AmdVendorCard_Click"
                        IsClickEnabled="True"
                        Header="AMD"
                        Description="Manage AMD GPU drivers and settings"
                        Style="{StaticResource ConfigurationSettingsCardTemplate}">
                        <controls:SettingsCard.HeaderIcon>
                            <ImageIcon Source="ms-appx:///assets/Icons/Amd.png" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border
                                Padding="8,4"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasAmdGpu, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Text="Detected" />
                            </Border>
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Click="NvidiaVendorCard_Click"
                        IsClickEnabled="True"
                        Header="NVIDIA"
                        Description="Manage NVIDIA GPU drivers and settings"
                        Style="{StaticResource ConfigurationSettingsCardTemplate}">
                        <controls:SettingsCard.HeaderIcon>
                            <ImageIcon Source="ms-appx:///assets/Icons/Nvidia.png" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border
                                Padding="8,4"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasNvidiaGpu, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Text="Detected" />
                            </Border>
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="VendorWorkspacePanel" Visibility="Collapsed">
                    <Button
                        Margin="0,0,0,16"
                        Click="BackToLandingPage_Click"
                        Background="Transparent"
                        BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="12" Glyph="&#xE72B;" />
                            <TextBlock Text="Back to GPU selection" />
                        </StackPanel>
                    </Button>

                    <TextBlock Style="{StaticResource GroupHeader}" Text="{Binding CurrentVendorTitle}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding CurrentVendorSubtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,12">
                        <Button x:Name="OverviewTabButton" Click="OverviewTab_Click" Style="{StaticResource BreadcrumbTabActive}" Content="Overview" />
                        <TextBlock Style="{StaticResource BreadcrumbChevron}" Text="/" />
                        <Button x:Name="DebloatTabButton" Click="DebloatTab_Click" Style="{StaticResource BreadcrumbTabInactive}" Content="Debloat" />
                        <TextBlock x:Name="PerformanceTabChevron" Style="{StaticResource BreadcrumbChevron}" Text="/" />
                        <Button x:Name="PerformanceTabButton" Click="PerformanceTab_Click" Style="{StaticResource BreadcrumbTabInactive}" Content="Performance" />
                        <TextBlock Style="{StaticResource BreadcrumbChevron}" Text="/" />
                        <Button x:Name="RemovalTabButton" Click="RemovalTab_Click" Style="{StaticResource BreadcrumbTabInactive}" Content="Removal" />
                    </StackPanel>

                    <StackPanel x:Name="OverviewPanel">
                        <controls:SettingsCard Margin="0,0,0,10" Header="Detected GPU" Description="Choose which installed GPU to manage." Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <controls:SettingsCard.HeaderIcon>
                                <ImageIcon Source="ms-appx:///assets/Icons/Gpu.png" />
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="GpuDeviceComboBox" Width="360" ItemsSource="{Binding GpuDevices}" SelectedItem="{Binding SelectedGpuDevice, Mode=TwoWay}" SelectionChanged="GpuDeviceComboBox_SelectionChanged" DisplayMemberPath="DisplayName" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Margin="0,0,0,10" Header="Driver version" Description="Fetch vendor releases for the selected GPU." Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <controls:SettingsCard.HeaderIcon>
                                <ImageIcon Source="ms-appx:///assets/Icons/Update.png" />
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ComboBox Width="360" ItemsSource="{Binding AvailableDrivers}" SelectedItem="{Binding SelectedDriver, Mode=TwoWay}" DisplayMemberPath="DisplayText" />
                                <Button x:Name="RefreshDriversButton" Click="RefreshDriversButton_Click" Content="Refresh" />
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard Margin="0,0,0,10" Header="Package actions" Description="Prepare the installer package for stock or customized installation." Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <controls:SettingsCard.HeaderIcon>
                                <ImageIcon Source="ms-appx:///assets/Icons/External.png" />
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="PrepareDriverButton" Click="PrepareDriverButton_Click" Content="Prepare package" Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="InstallPreparedDriverButton" Click="InstallPreparedDriverButton_Click" Content="Install prepared package" />
                                <Button x:Name="ReloadPreparedPackageButton" Click="ReloadPreparedPackageButton_Click" Content="Reload package" />
                            </StackPanel>
                        </controls:SettingsCard>

                        <InfoBar Margin="0,0,0,10" IsClosable="False" IsOpen="{Binding HasPreparedPackage}" Message="{Binding PreparedPackageSummary}" Severity="Informational" />

                        <StackPanel x:Name="NvidiaOverviewExtrasPanel" Visibility="Collapsed">
                            <InfoBar Margin="0,0,0,10" IsClosable="True" IsOpen="{Binding HasNvidiaApplyResult}" Message="{Binding NvidiaApplyResultSummary}" Severity="Informational" />

                            <TextBlock Style="{StaticResource GroupHeader}" Text="NVIDIA Profile Inspector" Margin="0,6,0,10" />

                            <controls:SettingsCard Margin="0,0,0,10" Description="{Binding NipFilePath}" Header=".nip profile file" Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                <controls:SettingsCard.HeaderIcon>
                                    <ImageIcon Source="ms-appx:///assets/Icons/Nvidia.png" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button x:Name="BrowseNipFileButton" Click="BrowseNipFileButton_Click" Content="Browse" />
                            </controls:SettingsCard>

                            <controls:SettingsCard Margin="0,0,0,10" Description="Pre-configured profiles bundled with SynToolkit." Header="Pre-configured profiles" Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                <controls:SettingsCard.HeaderIcon>
                                    <ImageIcon Source="ms-appx:///assets/Icons/Nvidia.png" />
                                </controls:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ComboBox x:Name="BundledProfilesComboBox" Width="220" DisplayMemberPath="DisplayName" ItemsSource="{Binding BundledProfiles}" PlaceholderText="No bundled profiles found" />
                                    <Button x:Name="LoadBundledProfileButton" Click="LoadBundledProfileButton_Click" Content="Load" />
                                </StackPanel>
                            </controls:SettingsCard>

                            <ItemsControl ItemsSource="{Binding NvidiaProfiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="nvidia:NvidiaProfile">
                                        <controls:SettingsExpander Margin="0,0,0,6" Description="{Binding ExecutablesSummary}" Header="{Binding ProfileName}">
                                            <controls:SettingsExpander.HeaderIcon>
                                                <ImageIcon Source="ms-appx:///assets/Icons/Games.png" />
                                            </controls:SettingsExpander.HeaderIcon>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Settings.Count}" />
                                            <controls:SettingsExpander.Items>
                                                <controls:SettingsCard ContentAlignment="Left">
                                                    <ItemsControl ItemsSource="{Binding Settings}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="nvidia:NvidiaProfileSetting">
                                                                <Grid Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding SettingNameInfo}" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SettingValue}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </controls:SettingsCard>
                                            </controls:SettingsExpander.Items>
                                        </controls:SettingsExpander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="ApplyNvidiaProfilesButton" Click="ApplyNvidiaProfilesButton_Click" Content="Apply to NVIDIA driver" Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="ExportLoadedProfilesButton" Click="ExportLoadedProfilesButton_Click" Content="Export loaded to .nip" />
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="8">
                                <Image Width="20" Height="20" VerticalAlignment="Center" Source="ms-appx:///assets/Icons/UserAccount.png" />
                                <TextBlock Style="{StaticResource SubGroupHeader}" Text="Create your own profile" VerticalAlignment="Center" />
                            </StackPanel>
                            <controls:SettingsCard Margin="0,0,0,10" Header="Profile name" Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                <controls:SettingsCard.HeaderIcon>
                                    <ImageIcon Source="ms-appx:///assets/Icons/UserAccount.png" />
                                </controls:SettingsCard.HeaderIcon>
                                <TextBox Width="220" Text="{Binding NewProfileName, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Margin="0,0,0,10" Description="Comma-separated executable names, e.g. game.exe, launcher.exe." Header="Executables" Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                <controls:SettingsCard.HeaderIcon>
                                    <ImageIcon Source="ms-appx:///assets/Icons/Applications.png" />
                                </controls:SettingsCard.HeaderIcon>
                                <TextBox Width="220" Text="{Binding NewProfileExecutablesText, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Image Width="20" Height="20" VerticalAlignment="Center" Source="ms-appx:///assets/Icons/Settings.png" />
                                    <TextBlock VerticalAlignment="Center" Text="Settings" />
                                </StackPanel>
                                <Button x:Name="AddNewSettingButton" Grid.Column="1" Click="AddNewSettingButton_Click" Content="Add setting" />
                            </Grid>

                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding NewProfileSettings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="nvidia:NvidiaProfileSetting">
                                        <controls:SettingsCard Margin="0,0,0,6" Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                            <controls:SettingsCard.HeaderIcon>
                                                <ImageIcon Source="ms-appx:///assets/Icons/Default.png" />
                                            </controls:SettingsCard.HeaderIcon>
                                            <controls:SettingsCard.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBox Width="150" PlaceholderText="Setting name" Text="{Binding SettingNameInfo, Mode=TwoWay}" />
                                                    <TextBox Width="90" PlaceholderText="Setting ID" Text="{Binding SettingIdText, Mode=TwoWay}" />
                                                </StackPanel>
                                            </controls:SettingsCard.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ComboBox Width="110" SelectedItem="{Binding ValueTypeText, Mode=TwoWay}">
                                                    <x:String>Dword</x:String>
                                                    <x:String>AnsiString</x:String>
                                                    <x:String>String</x:String>
                                                    <x:String>Binary</x:String>
                                                    <x:String>Qword</x:String>
                                                </ComboBox>
                                                <TextBox Width="120" PlaceholderText="Value" Text="{Binding SettingValue, Mode=TwoWay}" />
                                                <Button Click="RemoveNewSettingButton_Click" Content="Remove" Tag="{Binding}" />
                                            </StackPanel>
                                        </controls:SettingsCard>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="ExportNewProfileButton" Click="ExportNewProfileButton_Click" Content="Export new profile to .nip" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="DebloatPanel" Visibility="Collapsed">
                        <InfoBar Margin="0,0,0,10" IsClosable="False" IsOpen="{Binding HasPreparedPackage}" Message="Prepare a package in Overview, then customize its contents here before launching the installer." Severity="Informational" />
                        <controls:SettingsCard Margin="0,0,0,10" Header="Debloat preset" Description="Choose whether to keep the stock package, use the stripped preset, or customize manually." Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <controls:SettingsCard.HeaderIcon>
                                <ImageIcon Source="ms-appx:///assets/Icons/Settings.png" />
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="DebloatModeComboBox" Width="220" ItemsSource="{Binding DebloatModeOptions}" SelectedItem="{Binding SelectedDebloatModeText, Mode=TwoWay}" SelectionChanged="DebloatModeComboBox_SelectionChanged" />
                        </controls:SettingsCard>

                        <TextBlock Style="{StaticResource SubGroupHeader}" Text="Packages" />
                        <ItemsControl x:Name="PackageComponentsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="gpu:GpuPackageComponent">
                                    <controls:SettingsCard Margin="0,0,0,6" Header="{Binding Name}" Description="{Binding DetailText}" Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                        <CheckBox Content="{Binding ToggleColumnHeader}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" />
                                    </controls:SettingsCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource SubGroupHeader}" Text="Scheduled Tasks" />
                        <ItemsControl x:Name="ScheduledTaskComponentsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="gpu:GpuPackageComponent">
                                    <controls:SettingsCard Margin="0,0,0,6" Header="{Binding Name}" Description="{Binding DetailText}" Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                        <CheckBox Content="{Binding ToggleColumnHeader}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" />
                                    </controls:SettingsCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource SubGroupHeader}" Text="Display Driver Components" />
                        <ItemsControl x:Name="DisplayComponentsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="gpu:GpuPackageComponent">
                                    <controls:SettingsCard Margin="0,0,0,6" Header="{Binding Name}" Description="{Binding DetailText}" Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                        <CheckBox Content="{Binding ToggleColumnHeader}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" />
                                    </controls:SettingsCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource SubGroupHeader}" Text="Installer Folders" />
                        <ItemsControl x:Name="FolderComponentsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="gpu:GpuPackageComponent">
                                    <controls:SettingsCard Margin="0,0,0,6" Header="{Binding Name}" Description="{Binding DetailText}" Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                        <CheckBox Content="{Binding ToggleColumnHeader}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" />
                                    </controls:SettingsCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="PerformancePanel" Visibility="Collapsed">
                        <InfoBar Margin="0,0,0,10" IsClosable="False" IsOpen="True" Message="Registry-backed tweaks apply only to NVIDIA systems with an installed NVIDIA display driver." Severity="Informational" />

                        <Border Margin="0,0,0,10"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="NVIDIA performance tweaks" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Refresh this tab after switching GPUs or applying multiple changes to pull the current registry state back into the list." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                        <Button x:Name="RefreshNvidiaTweakStatesButton" Click="RefreshNvidiaTweakStatesButton_Click" Content="Refresh values" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,10"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="General NVIDIA registry settings." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                        <Button x:Name="ApplyNvidiaSettingsGroupButton" Click="ApplyNvidiaTweakGroup_Click" Tag="NvidiaSettings" Content="Apply all" />
                                        <Button x:Name="RevertNvidiaSettingsGroupButton" Click="RevertNvidiaTweakGroup_Click" Tag="NvidiaSettings" Content="Remove all" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="NvidiaSettingsListPanel" Spacing="0" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,10"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="RM Power Feature" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Driver power-management flags." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                        <Button x:Name="ApplyNvidiaRmPowerFeatureGroupButton" Click="ApplyNvidiaTweakGroup_Click" Tag="RmPowerFeature" Content="Apply all" />
                                        <Button x:Name="RevertNvidiaRmPowerFeatureGroupButton" Click="RevertNvidiaTweakGroup_Click" Tag="RmPowerFeature" Content="Remove all" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="NvidiaRmPowerFeatureListPanel" Spacing="0" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,10"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Telemetry" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Telemetry-related registry values." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                        <Button x:Name="ApplyNvidiaTelemetryGroupButton" Click="ApplyNvidiaTweakGroup_Click" Tag="Telemetry" Content="Apply all" />
                                        <Button x:Name="RevertNvidiaTelemetryGroupButton" Click="RevertNvidiaTweakGroup_Click" Tag="Telemetry" Content="Remove all" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="NvidiaTelemetryListPanel" Spacing="0" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,10"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="ECC" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="ECC-related registry values." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                        <Button x:Name="ApplyNvidiaEccGroupButton" Click="ApplyNvidiaTweakGroup_Click" Tag="Ecc" Content="Apply all" />
                                        <Button x:Name="RevertNvidiaEccGroupButton" Click="RevertNvidiaTweakGroup_Click" Tag="Ecc" Content="Remove all" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="NvidiaEccListPanel" Spacing="0" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,10"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="HDCP" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="HDCP-related registry values." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                        <Button x:Name="ApplyNvidiaHdcpGroupButton" Click="ApplyNvidiaTweakGroup_Click" Tag="Hdcp" Content="Apply all" />
                                        <Button x:Name="RevertNvidiaHdcpGroupButton" Click="RevertNvidiaTweakGroup_Click" Tag="Hdcp" Content="Remove all" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="NvidiaHdcpListPanel" Spacing="0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="RemovalPanel" Visibility="Collapsed">
                        <Border Margin="0,0,0,10"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Removal options" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Run the built-in driver cleanup workflow for the selected vendor." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Choose the cleanup steps below, then watch the live log update in-place once removal starts." Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                <CheckBox Content="Run vendor uninstaller" IsChecked="{Binding RunVendorUninstaller, Mode=TwoWay}" />
                                <CheckBox Content="Remove driver store packages" IsChecked="{Binding RemoveDriverStorePackages, Mode=TwoWay}" />
                                <CheckBox Content="Stop and remove services" IsChecked="{Binding RemoveServices, Mode=TwoWay}" />
                                <CheckBox Content="Delete leftover files" IsChecked="{Binding RemoveLeftoverFiles, Mode=TwoWay}" />
                                <CheckBox Content="Delete leftover registry entries" IsChecked="{Binding RemoveRegistryEntries, Mode=TwoWay}" />
                                <CheckBox Content="Block automatic driver reinstall" IsChecked="{Binding BlockAutomaticReinstall, Mode=TwoWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="RunRemovalButton" Click="RunRemovalButton_Click" Content="Run removal" Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="RebootNowButton" Click="RebootNowButton_Click" Content="Reboot now" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SubGroupHeader}" Text="Removal log" />
                        <Border
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            MaxHeight="240">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RemovalLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="gpu:GpuRemovalLogEntry">
                                            <TextBlock Margin="0,0,0,6" Text="{Binding Message}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

