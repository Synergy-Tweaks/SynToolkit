<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.GpuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SynToolkit.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nvidia="using:SynToolkit.Services.NvidiaProfileInspector"
    xmlns:radeon="using:SynToolkit.Services.RadeonSlimmer"
    xmlns:viewmodel="using:SynToolkit.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:GpuPageViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToSeverityConverter x:Key="BoolToSeverityConverter" />
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>
        <Style x:Key="SubGroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>

        <!--  Breadcrumb tab navigation styles  -->
        <Style x:Key="BreadcrumbTabActive" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="BreadcrumbTabInactive" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="BreadcrumbChevron" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
        </Style>

        <!--  Info button style for clickable tooltips  -->
        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </Page.Resources>

    <Grid Margin="55,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,24,36,8"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="GPU" />
        <StackPanel Grid.Row="1" Margin="0,0,36,18">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Import a downloaded AMD Radeon Software installer and remove bloat components before installing, or import an NVIDIA Profile Inspector .nip file and apply it to the driver." local:LocalizedText.TextKey="GpuPageText06668A0DDD3D"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,6,0,0"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{Binding DetectedGpuSummary, Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="2"
            Margin="0,0,36,18"
            IsClosable="True"
            IsOpen="{Binding HasError, Mode=OneWay}"
            Message="{Binding StatusMessage, Mode=OneWay}"
            Severity="Error"
            Title="GPU" />

        <ScrollViewer Grid.Row="3">
            <StackPanel Margin="0,0,36,48">

                <!--  VENDOR SELECTION LANDING PAGE  -->
                <!--  Styled as full-width rows matching Windows Settings list-item style  -->
                <StackPanel x:Name="VendorLandingPanel" Spacing="4">

                    <!--  AMD Row - full width, icon left, title+description middle, chevron right  -->
                    <controls:SettingsCard
                        Click="AmdVendorCard_Click"
                        IsClickEnabled="True"
                        Header="AMD" local:LocalizedText.HeaderKey="GpuPageHeaderC8897530DA3F"
                        Description="Manage AMD GPU drivers and settings" local:LocalizedText.DescriptionKey="GpuPageDescriptionF7CEC7DF21A1"
                        Style="{StaticResource ConfigurationSettingsCardTemplate}">
                        <controls:SettingsCard.HeaderIcon>
                            <ImageIcon Source="ms-appx:///assets/Icons/Amd.png" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border
                                x:Name="AmdDetectedBadge"
                                Padding="8,4"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasAmdGpu, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Text="Detected" local:LocalizedText.TextKey="GpuPageTextC1D480853A8A" />
                            </Border>
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <!--  NVIDIA Row - full width, icon left, title+description middle, chevron right  -->
                    <controls:SettingsCard
                        Click="NvidiaVendorCard_Click"
                        IsClickEnabled="True"
                        Header="NVIDIA" local:LocalizedText.HeaderKey="GpuPageHeaderDB7AC6B4ACE6"
                        Description="Manage NVIDIA GPU drivers and settings" local:LocalizedText.DescriptionKey="GpuPageDescriptionC5EBCCAA44E2"
                        Style="{StaticResource ConfigurationSettingsCardTemplate}">
                        <controls:SettingsCard.HeaderIcon>
                            <ImageIcon Source="ms-appx:///assets/Icons/Nvidia.png" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border
                                x:Name="NvidiaDetectedBadge"
                                Padding="8,4"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasNvidiaGpu, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Text="Detected" local:LocalizedText.TextKey="GpuPageTextC1D480853A8A" />
                            </Border>
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </StackPanel>
                    </controls:SettingsCard>

                </StackPanel>

                <!--  AMD VENDOR SECTION  -->
                <StackPanel x:Name="AmdVendorPanel" Visibility="Collapsed">

                    <!--  Back to landing page  -->
                    <Button
                        x:Name="AmdBackButton"
                        Margin="0,0,0,16"
                        Click="BackToLandingPage_Click"
                        Background="Transparent"
                        BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="12" Glyph="&#xE72B;" />
                            <TextBlock Text="Back to GPU selection" local:LocalizedText.TextKey="GpuPageTextAD7C77BDBC99" />
                        </StackPanel>
                    </Button>

                    <TextBlock Style="{StaticResource GroupHeader}" Text="AMD Radeon Software slimmer" local:LocalizedText.TextKey="GpuPageTextD2585326D759" Margin="0,0,0,10" />
                    <InfoBar
                        Margin="0,0,0,10"
                        IsClosable="False"
                        IsOpen="{Binding NoAmdGpuDetected, Mode=OneWay}"
                        Message="No AMD GPU was detected on this system. This section may not work correctly." local:LocalizedText.MessageKey="GpuPageMessageBD36B0D7E436"
                        Severity="Warning" />

                <StackPanel>

                    <!--  Step 1: select installer  -->
                    <StackPanel x:Name="SelectInstallerPanel" Margin="0,0,0,10">
                        <controls:SettingsCard
                            Margin="0,0,0,10"
                            Description="{Binding InstallerFilePath, Mode=OneWay}"
                            Header="Radeon Software installer" local:LocalizedText.HeaderKey="GpuPageHeader87029AA06993"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <controls:SettingsCard.HeaderIcon>
                                <ImageIcon Source="ms-appx:///assets/Icons/Amd.png" />
                            </controls:SettingsCard.HeaderIcon>
                            <Button x:Name="BrowseInstallerButton" Click="BrowseInstallerButton_Click" Content="Browse" local:LocalizedText.ContentKey="GpuPageContent1010A22C3055" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Margin="0,0,0,10"
                            Description="{Binding ExtractionFolderPath, Mode=OneWay}"
                            Header="Extraction folder" local:LocalizedText.HeaderKey="GpuPageHeader622E5C5CB354"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <controls:SettingsCard.HeaderIcon>
                                <ImageIcon Source="ms-appx:///assets/Icons/External.png" />
                            </controls:SettingsCard.HeaderIcon>
                            <Button x:Name="BrowseExtractionFolderButton" Click="BrowseExtractionFolderButton_Click" Content="Browse" local:LocalizedText.ContentKey="GpuPageContent1010A22C3055" />
                        </controls:SettingsCard>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Name="ExtractButton"
                                Click="ExtractButton_Click"
                                Content="Extract and continue" local:LocalizedText.ContentKey="GpuPageContentF53422BB3467"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="SkipExtractionButton"
                                Click="SkipExtractionButton_Click"
                                Content="This folder is already extracted" local:LocalizedText.ContentKey="GpuPageContent2F38E82ED1B2" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Step 2: extracting  -->
                    <StackPanel
                        x:Name="ExtractingPanel"
                        Margin="0,20,0,10"
                        HorizontalAlignment="Center"
                        Spacing="14"
                        Visibility="Collapsed">
                        <ProgressRing
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            IsActive="True" />
                        <TextBlock HorizontalAlignment="Center" Text="Extracting installer files..." local:LocalizedText.TextKey="GpuPageTextA3F97E271E13" />
                    </StackPanel>

                    <!--  Step 3: customize  -->
                    <StackPanel
                        x:Name="CustomizePanel"
                        Margin="0,0,0,10"
                        Visibility="Collapsed">

                        <!--  Reset success InfoBar  -->
                        <InfoBar
                            x:Name="ResetSuccessInfoBar"
                            Margin="0,0,0,10"
                            IsClosable="True"
                            IsOpen="{Binding HasResetSuccessMessage, Mode=OneWay}"
                            Message="{Binding ResetSuccessMessage, Mode=OneWay}"
                            Severity="Success"
                            Closed="ResetSuccessInfoBar_Closed" />

                        <!--  Optimization result InfoBar  -->
                        <InfoBar
                            x:Name="OptimizationResultInfoBar"
                            Margin="0,0,0,10"
                            IsClosable="True"
                            IsOpen="{Binding HasOptimizationResult, Mode=OneWay}"
                            Message="{Binding OptimizationResultMessage, Mode=OneWay}"
                            Severity="{Binding OptimizationResultIsWarning, Mode=OneWay, Converter={StaticResource BoolToSeverityConverter}}"
                            Closed="OptimizationResultInfoBar_Closed" />

                        <!--  Breadcrumb-style tab navigation  -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button
                                x:Name="PackagesTabButton"
                                Click="PackagesTab_Click"
                                Style="{StaticResource BreadcrumbTabActive}"
                                Content="Packages" local:LocalizedText.ContentKey="GpuPageContent3DA50DE7BEEE" />
                            <TextBlock Style="{StaticResource BreadcrumbChevron}" Text="›" />
                            <Button
                                x:Name="ScheduledTasksTabButton"
                                Click="ScheduledTasksTab_Click"
                                Style="{StaticResource BreadcrumbTabInactive}"
                                Content="Scheduled Tasks" local:LocalizedText.ContentKey="GpuPageContentE63A0405DE67" />
                            <TextBlock Style="{StaticResource BreadcrumbChevron}" Text="›" />
                            <Button
                                x:Name="DisplayComponentsTabButton"
                                Click="DisplayComponentsTab_Click"
                                Style="{StaticResource BreadcrumbTabInactive}"
                                Content="Display Driver Components" local:LocalizedText.ContentKey="GpuPageContentDFB2D4C80949" />
                        </StackPanel>

                        <!--  Global toolbar with Optimize Driver button  -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,12">
                            <Button
                                x:Name="OptimizeDriverButton"
                                Click="OptimizeDriverButton_Click"
                                Content="Optimize Driver" local:LocalizedText.ContentKey="GpuPageContent021013D0F6AD"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="OptimizeDriverInfoButton"
                                Style="{StaticResource InfoButtonStyle}"
                                ToolTipService.ToolTip="Applies a recommended configuration: disables all scheduled tasks, keeps only the display driver and AMD Settings packages, and keeps only the core display components.">
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <TextBlock
                                            MaxWidth="320"
                                            TextWrapping="Wrap"
                                            Text="Applies a recommended configuration: disables all scheduled tasks, keeps only the display driver and AMD Settings packages, and keeps only the core display components. If your imported package differs from AMD's standard layout, only matching items will be adjusted." local:LocalizedText.TextKey="GpuPageTextA9EEE4193E26" />
                                    </Flyout>
                                </Button.Flyout>
                                <FontIcon FontSize="14" Glyph="&#xE946;" />
                            </Button>
                        </StackPanel>

                        <!--  TAB 1: Packages  -->
                        <StackPanel x:Name="PackagesTabPanel">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Uncheck 'Keep' for packages you want to remove." local:LocalizedText.TextKey="GpuPageTextE34E1FDCD339" />
                                    <Button Style="{StaticResource InfoButtonStyle}" ToolTipService.ToolTip="Packages are MSI installers and drivers bundled with the AMD Radeon Software. Unchecked packages will be excluded from installation.">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <TextBlock
                                                    MaxWidth="300"
                                                    TextWrapping="Wrap"
                                                    Text="Packages are MSI installers and drivers bundled with the AMD Radeon Software. Unchecked packages will be excluded from installation." local:LocalizedText.TextKey="GpuPageTextB62855F6E149" />
                                            </Flyout>
                                        </Button.Flyout>
                                        <FontIcon FontSize="12" Glyph="&#xE946;" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Click="KeepAllPackages_Click" Content="Select All" local:LocalizedText.ContentKey="GpuPageContentE03C27EFA9C8" />
                                    <Button Click="RemoveAllPackages_Click" Content="Select None" local:LocalizedText.ContentKey="GpuPageContentEFB8BCD64AA5" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Packages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="radeon:RadeonPackage">
                                        <controls:SettingsCard
                                            Margin="0,0,0,6"
                                            Description="{x:Bind Description, Mode=OneWay}"
                                            Header="{x:Bind ProductName, Mode=OneWay}"
                                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                            <CheckBox Content="Keep" local:LocalizedText.ContentKey="GpuPageContent311C673C25C9" IsChecked="{x:Bind Keep, Mode=TwoWay}" />
                                        </controls:SettingsCard>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!--  TAB 2: Scheduled Tasks  -->
                        <StackPanel x:Name="ScheduledTasksTabPanel" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Uncheck 'Enabled' to disable the scheduled task." local:LocalizedText.TextKey="GpuPageText3D08116EF7A8" />
                                    <Button Style="{StaticResource InfoButtonStyle}" ToolTipService.ToolTip="Scheduled tasks are created by AMD to run background operations like driver updates, telemetry, and auto-launch features.">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <TextBlock
                                                    MaxWidth="300"
                                                    TextWrapping="Wrap"
                                                    Text="Scheduled tasks are created by AMD to run background operations like driver updates, telemetry, and auto-launch features. Disabling these prevents unnecessary background activity." local:LocalizedText.TextKey="GpuPageText14936C27052A" />
                                            </Flyout>
                                        </Button.Flyout>
                                        <FontIcon FontSize="12" Glyph="&#xE946;" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Click="EnableAllScheduledTasks_Click" Content="Select All" local:LocalizedText.ContentKey="GpuPageContentE03C27EFA9C8" />
                                    <Button Click="DisableAllScheduledTasks_Click" Content="Select None" local:LocalizedText.ContentKey="GpuPageContentEFB8BCD64AA5" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ScheduledTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="radeon:RadeonScheduledTask">
                                        <controls:SettingsCard
                                            Margin="0,0,0,6"
                                            Description="{x:Bind Command, Mode=OneWay}"
                                            Header="{x:Bind Description, Mode=OneWay}"
                                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                            <CheckBox Content="Enabled" local:LocalizedText.ContentKey="GpuPageContent4DA4000696E1" IsChecked="{x:Bind Enabled, Mode=TwoWay}" />
                                        </controls:SettingsCard>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!--  TAB 3: Display Driver Components  -->
                        <StackPanel x:Name="DisplayComponentsTabPanel" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Uncheck 'Keep' for components you want to remove." local:LocalizedText.TextKey="GpuPageText58AB99CEB612" />
                                    <Button Style="{StaticResource InfoButtonStyle}" ToolTipService.ToolTip="Display driver components are INF driver packages that provide specific GPU functionality.">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <TextBlock
                                                    MaxWidth="300"
                                                    TextWrapping="Wrap"
                                                    Text="Display driver components are INF driver packages that provide specific GPU functionality. Core components like the display driver, OpenCL, OpenGL, and Vulkan should be kept. Audio, camera, and telemetry components can typically be removed." local:LocalizedText.TextKey="GpuPageText3EB88E8793EF" />
                                            </Flyout>
                                        </Button.Flyout>
                                        <FontIcon FontSize="12" Glyph="&#xE946;" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Click="KeepAllDisplayComponents_Click" Content="Select All" local:LocalizedText.ContentKey="GpuPageContentE03C27EFA9C8" />
                                    <Button Click="RemoveAllDisplayComponents_Click" Content="Select None" local:LocalizedText.ContentKey="GpuPageContentEFB8BCD64AA5" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding DisplayComponents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="radeon:RadeonDisplayComponent">
                                        <controls:SettingsCard
                                            Margin="0,0,0,6"
                                            Header="{x:Bind Name, Mode=OneWay}"
                                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                            <CheckBox Content="Keep" local:LocalizedText.ContentKey="GpuPageContent311C673C25C9" IsChecked="{x:Bind Keep, Mode=TwoWay}" />
                                        </controls:SettingsCard>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Name="ApplyAndInstallButton"
                                Click="ApplyAndInstallButton_Click"
                                Content="Apply and open installer" local:LocalizedText.ContentKey="GpuPageContentC022DCF13526"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="ResetToDefaultsButton" Click="ResetToDefaultsButton_Click" Content="Reset to defaults" local:LocalizedText.ContentKey="GpuPageContent327832D2E055" />
                            <Button x:Name="StartOverButton" Click="StartOverButton_Click" Content="Start over" local:LocalizedText.ContentKey="GpuPageContentA17060C87DFA" />
                            <ProgressRing
                                Width="20"
                                Height="20"
                                IsActive="{Binding IsBusy, Mode=OneWay}"
                                Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Step 4: done  -->
                    <StackPanel
                        x:Name="DonePanel"
                        Margin="0,20,0,10"
                        HorizontalAlignment="Center"
                        Spacing="14"
                        Visibility="Collapsed">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="32"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Glyph="&#xE930;" />
                        <TextBlock HorizontalAlignment="Center" Text="The Radeon Software setup was launched. Finish installing there." local:LocalizedText.TextKey="GpuPageText126BF0F94725" TextWrapping="Wrap" />
                        <Button
                            x:Name="DoneStartOverButton"
                            HorizontalAlignment="Center"
                            Click="StartOverButton_Click"
                            Content="Start over" local:LocalizedText.ContentKey="GpuPageContentA17060C87DFA" />
                    </StackPanel>

                </StackPanel>

                </StackPanel>
                <!--  END AMD VENDOR SECTION  -->

                <!--  NVIDIA VENDOR SECTION  -->
                <StackPanel x:Name="NvidiaVendorPanel" Visibility="Collapsed">

                    <!--  Back to landing page  -->
                    <Button
                        x:Name="NvidiaBackButton"
                        Margin="0,0,0,16"
                        Click="BackToLandingPage_Click"
                        Background="Transparent"
                        BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="12" Glyph="&#xE72B;" />
                            <TextBlock Text="Back to GPU selection" local:LocalizedText.TextKey="GpuPageTextAD7C77BDBC99" />
                        </StackPanel>
                    </Button>

                    <TextBlock Style="{StaticResource GroupHeader}" Text="NVIDIA Profile Inspector" local:LocalizedText.TextKey="GpuPageText623166EBEAA8" Margin="0,0,0,10" />
                    <InfoBar
                        Margin="0,0,0,10"
                        IsClosable="False"
                        IsOpen="{Binding NoNvidiaGpuDetected, Mode=OneWay}"
                        Message="No NVIDIA GPU was detected on this system. This section may not work correctly." local:LocalizedText.MessageKey="GpuPageMessageF71D005BFBBD"
                        Severity="Warning" />
                    <InfoBar
                        Margin="0,0,0,10"
                        IsClosable="True"
                        IsOpen="{Binding HasNvidiaApplyResult, Mode=OneWay}"
                        Message="{Binding NvidiaApplyResultSummary, Mode=OneWay}"
                        Severity="Informational" />

                <StackPanel>
                    <controls:SettingsCard
                        Margin="0,0,0,10"
                        Description="{Binding NipFilePath, Mode=OneWay}"
                        Header=".nip profile file" local:LocalizedText.HeaderKey="GpuPageHeader30451174446E"
                        Style="{StaticResource ConfigurationSettingsCardTemplate}">
                        <controls:SettingsCard.HeaderIcon>
                            <ImageIcon Source="ms-appx:///assets/Icons/Nvidia.png" />
                        </controls:SettingsCard.HeaderIcon>
                        <Button x:Name="BrowseNipFileButton" Click="BrowseNipFileButton_Click" Content="Browse" local:LocalizedText.ContentKey="GpuPageContent1010A22C3055" />
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Margin="0,0,0,10"
                        Description="Pre-configured profiles bundled with SynToolkit (none ship by default — see assets/NvidiaProfiles/README.txt)." local:LocalizedText.DescriptionKey="GpuPageDescriptionF0E07566FA4F"
                        Header="Pre-configured profiles" local:LocalizedText.HeaderKey="GpuPageHeader9A8D43273E5B"
                        Style="{StaticResource ConfigurationSettingsCardTemplate}">
                        <controls:SettingsCard.HeaderIcon>
                            <ImageIcon Source="ms-appx:///assets/Icons/Nvidia.png" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox
                                x:Name="BundledProfilesComboBox"
                                Width="220"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding BundledProfiles}"
                                PlaceholderText="No bundled profiles found" />
                            <Button x:Name="LoadBundledProfileButton" Click="LoadBundledProfileButton_Click" Content="Load" local:LocalizedText.ContentKey="GpuPageContent43A188D59CEC" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <ItemsControl ItemsSource="{Binding NvidiaProfiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="nvidia:NvidiaProfile">
                                <controls:SettingsExpander
                                    Margin="0,0,0,6"
                                    Description="{x:Bind ExecutablesSummary, Mode=OneTime}"
                                    Header="{x:Bind ProfileName, Mode=OneTime}">
                                    <controls:SettingsExpander.HeaderIcon>
                                        <ImageIcon Source="ms-appx:///assets/Icons/Games.png" />
                                    </controls:SettingsExpander.HeaderIcon>
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Settings.Count, Mode=OneTime}" />
                                    <controls:SettingsExpander.Items>
                                        <controls:SettingsCard ContentAlignment="Left">
                                            <ItemsControl ItemsSource="{x:Bind Settings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="nvidia:NvidiaProfileSetting">
                                                        <Grid Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind SettingNameInfo, Mode=OneTime}" TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Margin="10,0,0,0"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind SettingValue, Mode=OneTime}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </controls:SettingsCard>
                                    </controls:SettingsExpander.Items>
                                </controls:SettingsExpander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="10">
                        <Button
                            x:Name="ApplyNvidiaProfilesButton"
                            Click="ApplyNvidiaProfilesButton_Click"
                            Content="Apply to NVIDIA driver" local:LocalizedText.ContentKey="GpuPageContentFDAEF53F2C20"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="ExportLoadedProfilesButton"
                            Click="ExportLoadedProfilesButton_Click"
                            Content="Export loaded to .nip" local:LocalizedText.ContentKey="GpuPageContentE63BC4F3F882" />
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{Binding IsApplyingNvidiaProfiles, Mode=OneWay}"
                            Visibility="{Binding IsApplyingNvidiaProfiles, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <!--  Create your own .nip profile  -->
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="8">
                        <Image
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Source="ms-appx:///assets/Icons/UserAccount.png" />
                        <TextBlock Style="{StaticResource SubGroupHeader}" Text="Create your own profile" local:LocalizedText.TextKey="GpuPageText5E62F195C004" VerticalAlignment="Center" />
                    </StackPanel>
                    <controls:SettingsCard
                        Margin="0,0,0,10"
                        Header="Profile name" local:LocalizedText.HeaderKey="GpuPageHeaderAC283BA30A9F"
                        Style="{StaticResource ConfigurationSettingsCardTemplate}">
                        <controls:SettingsCard.HeaderIcon>
                            <ImageIcon Source="ms-appx:///assets/Icons/UserAccount.png" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBox Width="220" Text="{Binding NewProfileName, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Margin="0,0,0,10"
                        Description="Comma-separated executable names, e.g. game.exe, launcher.exe. Leave blank for a base profile that applies to all applications." local:LocalizedText.DescriptionKey="GpuPageDescriptionF27AFB4CDFAD"
                        Header="Executables" local:LocalizedText.HeaderKey="GpuPageHeader3EE89599DB6C"
                        Style="{StaticResource ConfigurationSettingsCardTemplate}">
                        <controls:SettingsCard.HeaderIcon>
                            <ImageIcon Source="ms-appx:///assets/Icons/Applications.png" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBox Width="220" Text="{Binding NewProfileExecutablesText, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Source="ms-appx:///assets/Icons/Settings.png" />
                            <TextBlock VerticalAlignment="Center" Text="Settings" local:LocalizedText.TextKey="GpuPageText91F2E57EF962" />
                        </StackPanel>
                        <Button
                            x:Name="AddNewSettingButton"
                            Grid.Column="1"
                            Click="AddNewSettingButton_Click"
                            Content="Add setting" local:LocalizedText.ContentKey="GpuPageContent75C8D994E411" />
                    </Grid>

                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding NewProfileSettings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="nvidia:NvidiaProfileSetting">
                                <controls:SettingsCard Margin="0,0,0,6" Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                    <controls:SettingsCard.HeaderIcon>
                                        <ImageIcon Source="ms-appx:///assets/Icons/Default.png" />
                                    </controls:SettingsCard.HeaderIcon>
                                    <controls:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox
                                                Width="150"
                                                PlaceholderText="Setting name" local:LocalizedText.PlaceholderTextKey="GpuPagePlaceholderTextA7AC0A21A7C9"
                                                Text="{x:Bind SettingNameInfo, Mode=TwoWay}" />
                                            <TextBox
                                                Width="90"
                                                PlaceholderText="Setting ID" local:LocalizedText.PlaceholderTextKey="GpuPagePlaceholderText51D2F207784F"
                                                Text="{x:Bind SettingIdText, Mode=TwoWay}" />
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox
                                            Width="110"
                                            SelectedItem="{x:Bind ValueTypeText, Mode=TwoWay}">
                                            <x:String>Dword</x:String>
                                            <x:String>AnsiString</x:String>
                                            <x:String>String</x:String>
                                            <x:String>Binary</x:String>
                                            <x:String>Qword</x:String>
                                        </ComboBox>
                                        <TextBox
                                            Width="120"
                                            PlaceholderText="Value" local:LocalizedText.PlaceholderTextKey="GpuPagePlaceholderTextFD59CDAB4C9D"
                                            Text="{x:Bind SettingValue, Mode=TwoWay}" />
                                        <Button Click="RemoveNewSettingButton_Click" Content="Remove" local:LocalizedText.ContentKey="GpuPageContent6BA9EA1B7E66" Tag="{x:Bind}" />
                                    </StackPanel>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="10">
                        <Image
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Source="ms-appx:///assets/Icons/External.png" />
                        <Button
                            x:Name="ExportNewProfileButton"
                            Click="ExportNewProfileButton_Click"
                            Content="Export new profile to .nip" local:LocalizedText.ContentKey="GpuPageContent3CFAEF9F3C36"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                </StackPanel>
                <!--  END NVIDIA VENDOR SECTION  -->

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
