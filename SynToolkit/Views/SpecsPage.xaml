<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.SpecsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SynToolkit.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:SynToolkit.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:SpecsPageViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:FontIconConverter x:Key="FontIconConverter" />
        <local:ImageSourceConverter x:Key="ImageSourceConverter" />
    </Page.Resources>

    <Grid Margin="55,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,24,36,8"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Specs" local:LocalizedText.TextKey="SpecsPageTitle" />
        <TextBlock
            Grid.Row="1"
            Margin="0,0,36,18"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="A read-only snapshot of this system's hardware and Windows version. Nothing here can be changed." local:LocalizedText.TextKey="SpecsPageDescription"
            TextWrapping="Wrap" />

        <InfoBar
            Grid.Row="2"
            Margin="0,0,36,18"
            IsClosable="True"
            IsOpen="{Binding HasError, Mode=OneWay}"
            Message="{Binding ErrorMessage, Mode=OneWay}"
            Severity="Error"
            Title="Specs" local:LocalizedText.TitleKey="SpecsPageErrorTitle" />

        <ProgressRing
            Grid.Row="3"
            Width="32"
            Height="32"
            Margin="0,24,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsActive="{Binding IsLoading, Mode=OneWay}"
            Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ScrollViewer Grid.Row="3">
            <StackPanel Margin="0,0,36,48">
                <controls:SettingsExpander
                    Margin="0,0,0,10"
                    Collapsed="CpuDetailsExpander_Collapsed"
                    Description="{Binding CpuDetailsText, Mode=OneWay}"
                    Expanded="CpuDetailsExpander_Expanded"
                    Header="{Binding CpuName, Mode=OneWay}"
                    Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                    <controls:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="ms-appx:///assets/Icons/Cpu.png" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <StackPanel Spacing="8">
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Utilization (live)" local:LocalizedText.TextKey="SpecsPageCpuUtilization" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding CpuUtilizationText, Mode=OneWay}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Current frequency (live)" local:LocalizedText.TextKey="SpecsPageCpuCurrentFrequency" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding CpuCurrentFrequencyText, Mode=OneWay}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Observed frequency (this visit)" local:LocalizedText.TextKey="SpecsPageCpuObservedFrequency" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding CpuObservedFrequencyText, Mode=OneWay}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding CpuDetails}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodel:CpuDetailDisplay">
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label, Mode=OneTime}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Value, Mode=OneTime}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander
                    Margin="0,0,0,10"
                    Description="{Binding MotherboardText, Mode=OneWay}"
                    Expanded="MotherboardDetailsExpander_Expanded"
                    Header="Motherboard" local:LocalizedText.HeaderKey="SpecsPageMotherboard"
                    Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                    <controls:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="ms-appx:///assets/Icons/Motherboard.png" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <ItemsControl ItemsSource="{Binding MotherboardDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:MotherboardDetailDisplay">
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label, Mode=OneTime}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                HorizontalAlignment="Stretch"
                                                Text="{x:Bind Value, Mode=OneTime}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander
                    Margin="0,0,0,10"
                    Description="{Binding MemoryDescriptionText, Mode=OneWay}"
                    Header="Memory" local:LocalizedText.HeaderKey="SpecsPageMemory"
                    Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                    <controls:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="ms-appx:///assets/Icons/Ram.png" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <ItemsControl ItemsSource="{Binding MemoryModules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:MemoryModuleDisplay">
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind ManufacturerText, Mode=OneTime}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind CapacityText, Mode=OneTime}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander
                    Margin="0,0,0,10"
                    Header="Graphics" local:LocalizedText.HeaderKey="SpecsPageGraphics"
                    Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                    <controls:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="{Binding GraphicsHeaderIcon, Mode=OneWay, Converter={StaticResource ImageSourceConverter}}" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <ItemsControl ItemsSource="{Binding Gpus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:GpuSpecDisplay">
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Width="24"
                                                Height="24"
                                                Margin="0,0,10,0"
                                                Source="{x:Bind IconPath, Mode=OneTime, Converter={StaticResource ImageSourceConverter}}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind DriverVersionText, Mode=OneTime}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind VramText, Mode=OneTime}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <controls:SettingsExpander
                    Margin="0,0,0,10"
                    Header="Storage" local:LocalizedText.HeaderKey="SpecsPageStorage"
                    Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                    <controls:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="ms-appx:///assets/Icons/Storage.png" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <ItemsControl ItemsSource="{Binding StorageDrives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:StorageDriveDisplay">
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Model, Mode=OneTime}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind TypeText, Mode=OneTime}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind SizeText, Mode=OneTime}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander
                    Margin="0,0,0,10"
                    Description="{Binding NetworkSummaryText, Mode=OneWay}"
                    Header="Network" local:LocalizedText.HeaderKey="SpecsPageNetwork"
                    Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                    <controls:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="ms-appx:///assets/Icons/Network.png" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <ItemsControl ItemsSource="{Binding NetworkAdapters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:NetworkAdapterDisplay">
                                        <Grid Margin="0,4,0,4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind ManufacturerText, Mode=OneTime}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind StatusText, Mode=OneTime}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,2,0,0"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind DetailsText, Mode=OneTime}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <controls:SettingsCard
                    Margin="0,0,0,10"
                    Header="Windows" local:LocalizedText.HeaderKey="SpecsPageWindows"
                    Style="{StaticResource ConfigurationSettingsCardTemplate}">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///assets/Icons/Windows.png" />
                    </controls:SettingsCard.HeaderIcon>
                    <TextBlock VerticalAlignment="Center" Text="{Binding WindowsText, Mode=OneWay}" TextWrapping="Wrap" />
                </controls:SettingsCard>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
