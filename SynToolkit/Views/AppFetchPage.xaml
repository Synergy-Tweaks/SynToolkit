<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.AppFetchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SynToolkit.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:SynToolkit.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:AppFetchPageViewModel}"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:ImageSourceConverter x:Key="ImageSourceConverter" />
    </Page.Resources>

    <ScrollViewer
        x:Name="MainScrollViewer"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1180"
            Margin="36,28,36,56"
            HorizontalAlignment="Stretch"
            Spacing="24">

            <!--  Page heading  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="52"
                    Height="52"
                    Margin="0,0,16,0"
                    Source="ms-appx:///assets/Icons/Installer.png"
                    Stretch="Uniform" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Text="Installers" local:LocalizedText.TextKey="AppFetchPageText67A0C620AF19" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Get everyday apps from trusted sources, or search the Microsoft Store catalog." local:LocalizedText.TextKey="AppFetchPageText3026BA63725A"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="Selected apps use Microsoft's WinGet package catalog. Every card also keeps a publisher link for manual downloads." local:LocalizedText.MessageKey="AppFetchPageMessage161B2EDB70D9"
                Severity="Success"
                Title="Official sources" local:LocalizedText.TitleKey="AppFetchPageTitle708CC1A604F0" />

            <!--  Curated installer controls  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="App catalog" local:LocalizedText.TextKey="AppFetchPageTextBFDC5E280E8C" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Search the curated library, filter by category, or start with the Essentials preset." local:LocalizedText.TextKey="AppFetchPageTextCD82567A5BEE"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{Binding CatalogResultsSummary, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        Width="18"
                        Height="18"
                        IsActive="{Binding IsRefreshingInstallerStates, Mode=OneWay}"
                        Visibility="{Binding IsRefreshingInstallerStates, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button
                        Command="{Binding RefreshInstallerStatesCommand}"
                        Content="Refresh status" local:LocalizedText.ContentKey="AppFetchPageContent2AB48378ABE3"
                        IsEnabled="{Binding CanRefreshInstallerStates, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <Border
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        MinWidth="280"
                        PlaceholderText="Search apps — try browser, Git, music..." local:LocalizedText.PlaceholderTextKey="AppFetchPagePlaceholderText5141A9F33B95"
                        Text="{Binding CatalogSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <AutoSuggestBox.QueryIcon>
                            <FontIcon Glyph="&#xE721;" />
                        </AutoSuggestBox.QueryIcon>
                    </AutoSuggestBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Category" local:LocalizedText.TextKey="AppFetchPageText9F2D0D0AB06B" />
                        <ComboBox
                            MinWidth="165"
                            ItemsSource="{Binding Categories, Mode=OneWay}"
                            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="17"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE735;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding SelectedSummary, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Command="{Binding SelectEssentialsCommand}"
                                Content="Add essentials" local:LocalizedText.ContentKey="AppFetchPageContent228F711511BB" />
                            <Button
                                Command="{Binding ClearInstallerSelectionCommand}"
                                Content="Clear queue" local:LocalizedText.ContentKey="AppFetchPageContentABEB855B4156" />
                        </StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding InstallerStatusSummary, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        MinWidth="156"
                        VerticalAlignment="Center"
                        Command="{Binding InstallSelectedCommand}"
                        Content="{Binding InstallSelectedText, Mode=OneWay}"
                        IsEnabled="{Binding CanInstallSelected, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>

            <!--  Sequential installation queue  -->
            <Border
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SystemAccentColorLight2}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding IsQueueVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Installation queue" local:LocalizedText.TextKey="AppFetchPageText0B8013CF2C7A" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding QueueSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button
                                Command="{Binding RetryFailedCommand}"
                                Content="Retry failed" local:LocalizedText.ContentKey="AppFetchPageContent762515BE0BB5"
                                IsEnabled="{Binding CanRetryFailed, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                Command="{Binding CancelInstallQueueCommand}"
                                Content="Cancel queue" local:LocalizedText.ContentKey="AppFetchPageContentD35A08A87AA1"
                                IsEnabled="{Binding IsInstallingQueue, Mode=OneWay}" />
                            <Button
                                Command="{Binding DismissInstallQueueCommand}"
                                Content="Close" local:LocalizedText.ContentKey="AppFetchPageContentE4D96BC06E38"
                                IsEnabled="{Binding CanDismissQueue, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding InstallQueue, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="34"
                                            Height="34"
                                            Padding="6"
                                            Background="White"
                                            CornerRadius="7">
                                            <Image Source="{Binding IconSource, Converter={StaticResource ImageSourceConverter}}" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Detail}" />
                                            <ProgressBar
                                                Height="3"
                                                Margin="0,5,0,0"
                                                Maximum="100"
                                                Minimum="0"
                                                Value="{Binding Progress}"
                                                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                        <Grid Grid.Column="2" Width="28" Height="28" VerticalAlignment="Center">
                                            <FontIcon
                                                FontSize="16"
                                                Glyph="{Binding StateGlyph}" />
                                            <ProgressRing
                                                Width="24"
                                                Height="24"
                                                IsActive="{Binding IsInstalling}"
                                                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ItemsRepeater ItemsSource="{Binding FeaturedInstallers, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsJustification="Start"
                        ItemsStretch="Fill"
                        MinColumnSpacing="12"
                        MinItemHeight="268"
                        MinItemWidth="270"
                        MinRowSpacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border
                            MinHeight="268"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="48"
                                        Height="48"
                                        Margin="0,0,14,0"
                                        Padding="6"
                                        Background="White"
                                        BorderBrush="#18000000"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <Image
                                            Source="{Binding IconSource, Converter={StaticResource ImageSourceConverter}}"
                                            Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            MaxLines="2"
                                            Text="{Binding Name}"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{Binding Category}" />
                                            <Border
                                                Padding="5,1"
                                                Background="{ThemeResource SystemAccentColorLight2}"
                                                CornerRadius="6"
                                                Visibility="{Binding IsEssential, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="White"
                                                    Text="Essential" local:LocalizedText.TextKey="AppFetchPageTextB91F12E76200" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    MinHeight="40"
                                    Margin="0,16,0,12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="2"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="WrapWholeWords" />
                                <Border
                                    Grid.Row="2"
                                    Margin="0,0,0,10"
                                    Padding="9,6"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                                            <FontIcon
                                                FontSize="14"
                                                Glyph="{Binding StatusGlyph, Mode=OneWay}" />
                                            <ProgressRing
                                                Width="17"
                                                Height="17"
                                                IsActive="{Binding IsCheckingStatus, Mode=OneWay}"
                                                Visibility="{Binding IsCheckingStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{Binding StatusText, Mode=OneWay}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{Binding StatusDetail, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="3" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <HyperlinkButton
                                        HorizontalAlignment="Left"
                                        Padding="0"
                                        NavigateUri="{Binding DownloadUri}"
                                        VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{Binding PublisherLinkText, Mode=OneWay}" />
                                            <FontIcon FontSize="11" Glyph="&#xE8A7;" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="6">
                                        <StackPanel
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Visibility="{Binding CanSelect, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <CheckBox
                                                VerticalAlignment="Center"
                                                Content="{Binding QueueSelectionText, Mode=OneWay}"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                ToolTipService.ToolTip="Add this app to the multi-app queue" />
                                            <Button
                                                MinWidth="72"
                                                Click="InstallerPrimaryAction_Click"
                                                Content="{Binding PrimaryActionText, Mode=OneWay}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                ToolTipService.ToolTip="Install or update this app now" />
                                        </StackPanel>
                                        <Button
                                            HorizontalAlignment="Right"
                                            MinWidth="86"
                                            Click="InstallerUninstall_Click"
                                            Content="{Binding UninstallActionText, Mode=OneWay}"
                                            IsEnabled="{Binding IsUninstallButtonEnabled, Mode=OneWay}"
                                            ToolTipService.ToolTip="Uninstall this app"
                                            Visibility="{Binding CanUninstall, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border
                Padding="32"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasNoCatalogResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="28"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE721;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="No apps found" local:LocalizedText.TextKey="AppFetchPageTextD073A8F13879" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Try another name or switch the category to All." local:LocalizedText.TextKey="AppFetchPageText960727FF28C2"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Microsoft Store search  -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="Microsoft Store search" local:LocalizedText.TextKey="AppFetchPageText08D995568EAB" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Search by app name, publisher, or product ID." local:LocalizedText.TextKey="AppFetchPageText4B4E9224FD31"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            MinWidth="240"
                            PlaceholderText="Try Spotify, PowerToys, or WhatsApp" local:LocalizedText.PlaceholderTextKey="AppFetchPagePlaceholderText8D94D6072F17"
                            QuerySubmitted="SearchBox_QuerySubmitted">
                            <AutoSuggestBox.QueryIcon>
                                <FontIcon Glyph="&#xE721;" />
                            </AutoSuggestBox.QueryIcon>
                        </AutoSuggestBox>
                        <Button
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Click="SearchButton_Click"
                            Content="Search" local:LocalizedText.ContentKey="AppFetchPageContent13F898CC2532"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Search status and results  -->
            <StackPanel x:Name="ResultsSection" Spacing="14">
                <InfoBar
                    IsClosable="True"
                    IsOpen="{Binding HasError, Mode=OneWay}"
                    Message="{Binding ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Title="Installers" local:LocalizedText.TitleKey="AppFetchPageTitleC1B1A65A8077" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{Binding IsXboxServicesTweakApplied, Mode=OneWay}"
                    Message="SynToolkit's Xbox-services tweak can prevent some games and Xbox apps from installing or running. Revert it here if an install fails." local:LocalizedText.MessageKey="AppFetchPageMessage0F37F891C40C"
                    Severity="Warning"
                    Title="Some apps may need Xbox services" local:LocalizedText.TitleKey="AppFetchPageTitle334C04027D82">
                    <InfoBar.ActionButton>
                        <Button
                            Command="{Binding RevertXboxServicesTweakCommand}"
                            Content="Revert tweak" local:LocalizedText.ContentKey="AppFetchPageContentE3EC6F22138E"
                            IsEnabled="{Binding IsRevertXboxServicesButtonEnabled, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <ProgressRing
                    Width="32"
                    Height="32"
                    Margin="0,12,0,8"
                    HorizontalAlignment="Center"
                    IsActive="{Binding IsLoading, Mode=OneWay}"
                    Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:SettingsCard
                                Margin="0,0,0,10"
                                Description="{Binding Description, Mode=OneWay}"
                                Header="{Binding Name, Mode=OneWay}"
                                Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                <controls:SettingsCard.HeaderIcon>
                                    <BitmapIcon
                                        ShowAsMonochrome="False"
                                        UriSource="{Binding IconUri, Mode=OneWay}" />
                                </controls:SettingsCard.HeaderIcon>
                                <StackPanel MinWidth="190" Spacing="8">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Publisher, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <ProgressBar
                                        Height="4"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="{Binding Progress, Mode=OneWay}"
                                        Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                        <HyperlinkButton
                                            Padding="8,4"
                                            Content="Store page" local:LocalizedText.ContentKey="AppFetchPageContent7E0F37EE3622"
                                            NavigateUri="{Binding StorePageUri, Mode=OneWay}" />
                                        <Button
                                            Command="{Binding CancelCommand, Mode=OneWay}"
                                            Content="Cancel" local:LocalizedText.ContentKey="AppFetchPageContent33AFBAF2F078"
                                            Visibility="{Binding IsCancelable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Button
                                            Command="{Binding InstallOrUninstallCommand, Mode=OneWay}"
                                            Content="{Binding ButtonText, Mode=OneWay}"
                                            IsEnabled="{Binding IsButtonEnabled, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
