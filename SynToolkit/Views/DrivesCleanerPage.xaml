<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.DrivesCleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SynToolkit.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:SynToolkit.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:DrivesCleanerViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter" />
    </Page.Resources>

    <Grid Margin="55,0,24,18" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock
                Margin="0,24,0,0"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Drives Cleaner"
                local:LocalizedText.TextKey="DrivesCleaner_Title" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Scan and clean temporary files, caches and other safe cleanup targets."
                TextWrapping="Wrap"
                local:LocalizedText.TextKey="DrivesCleaner_Description" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <InfoBar
                Margin="0,0,0,4"
                IsClosable="True"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Title="Drives Cleaner" />
            <InfoBar
                Margin="0,0,0,4"
                IsClosable="True"
                IsOpen="True"
                Message="Some Windows cleanup categories require administrator rights."
                Severity="Warning"
                Title="Administrator access recommended"
                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
            <InfoBar
                Margin="0,0,0,8"
                IsClosable="True"
                IsOpen="True"
                Message="{Binding LastResultText}"
                Severity="Success"
                Title="Cleanup complete"
                Visibility="{Binding HasLastResult, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <Pivot Grid.Row="2" SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}">
            <PivotItem>
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="Clean up" local:LocalizedText.TextKey="DrivesCleaner_TabCleanup" />
                    </StackPanel>
                </PivotItem.Header>

                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ScanCommand}" Content="Scan" Style="{StaticResource AccentButtonStyle}" local:LocalizedText.ContentKey="DrivesCleaner_Scan" />
                        <Button Grid.Column="1" Command="{Binding SelectSafeCommand}" Content="Select all safe" local:LocalizedText.ContentKey="DrivesCleaner_SelectSafe" />
                        <Button Grid.Column="2" Command="{Binding ClearSelectionCommand}" Content="Clear selection" local:LocalizedText.ContentKey="DrivesCleaner_SelectNone" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <ProgressRing Width="18" Height="18" IsActive="{Binding IsScanning}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <ProgressRing Width="18" Height="18" IsActive="{Binding IsCleaning}" Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding StatusText}" />
                        </StackPanel>
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{Binding Categories}" SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <!--  Cards draw their own chrome; the default ListViewItem hover/press
                                  layer sits on top of them and swallows clicks on the controls.  -->
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter Property="UseSystemFocusVisuals" Value="False" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter
                                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:CleanerCategoryViewModel">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!--  Fixed-width slot keeps rows aligned when a category has no checkbox.  -->
                                            <Grid Grid.Column="0" Width="32" VerticalAlignment="Center">
                                                <CheckBox
                                                    MinWidth="0"
                                                    Padding="0"
                                                    IsThreeState="False"
                                                    Command="{x:Bind ToggleSelectedCommand}"
                                                    IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                    Visibility="{x:Bind ShowCheckBox, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    AutomationProperties.Name="{x:Bind Title}" />
                                            </Grid>
                                            <FontIcon Grid.Column="1" VerticalAlignment="Center" Glyph="{x:Bind Glyph}" />
                                            <!--  Clicking the text expands the card, like the chevron does.  -->
                                            <StackPanel
                                                Grid.Column="2"
                                                Background="Transparent"
                                                Spacing="2"
                                                Tapped="CategoryHeader_Tapped">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Description}"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind SizeText}" />
                                            <Border
                                                Grid.Column="4"
                                                Padding="8,1"
                                                VerticalAlignment="Center"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                IsHitTestVisible="False">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind SafetyText}" />
                                            </Border>
                                            <Grid Grid.Column="5" Width="36" VerticalAlignment="Center">
                                                <Button
                                                    Padding="6"
                                                    Command="{x:Bind ToggleExpandCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Visibility="{x:Bind ShowExpand, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    AutomationProperties.Name="Expand category">
                                                    <FontIcon FontSize="12" Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
                                                </Button>
                                            </Grid>
                                        </Grid>

                                        <StackPanel Spacing="6" Visibility="{x:Bind ShowDetails, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Text="{x:Bind Note}"
                                                Visibility="{x:Bind HasNote, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <Button
                                                Content="Open Storage settings"
                                                Command="{x:Bind OpenSettingsCommand}"
                                                Visibility="{x:Bind IsSettings, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <Button
                                                Content="Turn off hibernation"
                                                Command="{x:Bind TurnOffHibernationCommand}"
                                                CommandParameter="{Binding}"
                                                Visibility="{x:Bind IsHibernation, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                Visibility="{x:Bind IsBlocked, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="This category needs administrator rights." />
                                                <Button
                                                    Content="Restart as admin"
                                                    Command="{x:Bind RestartAdminCommand}"
                                                    Visibility="{x:Bind CanRestartAsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>

                                            <!--  ItemsControl, not a nested ListView: a ListView inside a ListView item
                                                  steals pointer and wheel input from the checkboxes and buttons.  -->
                                            <ItemsControl
                                                ItemsSource="{x:Bind VisibleItems}"
                                                Visibility="{x:Bind ShowItemList, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewmodel:CleanerItemViewModel">
                                                        <Grid ColumnSpacing="8" Padding="2,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox
                                                                Grid.Column="0"
                                                                VerticalAlignment="Center"
                                                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                Visibility="{x:Bind Selectable, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            <StackPanel Grid.Column="1" Spacing="1">
                                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind Detail}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind PathText}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind SizeText}" />
                                                            <Button Grid.Column="3" Command="{x:Bind RevealCommand}" Content="Reveal" />
                                                            <Button
                                                                Grid.Column="4"
                                                                Command="{x:Bind UninstallCommand}"
                                                                Content="Uninstall"
                                                                Visibility="{x:Bind IsSteam, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind HiddenText}"
                                                Visibility="{x:Bind HasHidden, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding AppliedSummary}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding ReviewSummary}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Click="CleanSelectedButton_Click"
                                Content="{Binding CleanButtonText}"
                                IsEnabled="{Binding CanClean}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </PivotItem>

            <PivotItem IsEnabled="{Binding CanSwitchToSpaceMap}">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Space map is unavailable while cleaning is running." />
                        </ToolTipService.ToolTip>
                        <FontIcon FontSize="14" Glyph="&#xECA5;" />
                        <TextBlock Text="Space map" local:LocalizedText.TextKey="DrivesCleaner_TabSpaceMap" />
                    </StackPanel>
                </PivotItem.Header>

                <Grid Margin="0,8,0,0" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Drive picker, usage bar and scan button  -->
                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            Grid.Column="0"
                            MinWidth="200"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Title"
                            IsEnabled="{Binding CanPickSpaceMapDrive}"
                            ItemsSource="{Binding Drives}"
                            SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <ProgressBar Maximum="100" Value="{Binding SelectedDriveUsedPercent}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding SelectedDriveSummary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="18" Height="18" IsActive="{Binding IsSpaceMapScanning}" Visibility="{Binding IsSpaceMapScanning, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SpaceMapStatus}" />
                            <Button Command="{Binding ScanSpaceMapCommand}" Content="Scan map" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <!--  Where we are in the folder tree  -->
                    <Grid Grid.Row="1" ColumnSpacing="8" Visibility="{Binding HasSpaceMapData, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Padding="8,4"
                            Command="{Binding SpaceMapUpCommand}"
                            IsEnabled="{Binding CanSpaceMapGoUp}"
                            ToolTipService.ToolTip="Up one folder"
                            AutomationProperties.Name="Up one folder">
                            <FontIcon FontSize="14" Glyph="&#xE74A;" />
                        </Button>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding SpaceMapPath}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SpaceMapCurrentSize}" />
                        <Button Grid.Column="3" Padding="8,4" Command="{Binding RevealSpaceMapCurrentCommand}" Content="Open folder" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="320" />
                            <ColumnDefinition Width="2*" MinWidth="260" />
                        </Grid.ColumnDefinitions>

                        <!--  Folders by size: click a folder to drill into it  -->
                        <Border
                            Grid.Column="0"
                            Padding="4,12,4,4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="12,0" FontWeight="SemiBold" Text="Folders by size" />
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="12,4"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Pick a drive and press Scan map to see what is using space."
                                    TextWrapping="Wrap"
                                    Visibility="{Binding ShowSpaceMapEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ListView
                                    Grid.Row="1"
                                    IsItemClickEnabled="True"
                                    ItemClick="SpaceMapList_ItemClick"
                                    ItemsSource="{Binding SpaceMapRows}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodel:SpaceMapRowViewModel">
                                            <Grid Padding="0,6" ColumnSpacing="10" RowSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="16" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <FontIcon Grid.RowSpan="2" VerticalAlignment="Center" FontSize="16" Glyph="{x:Bind Glyph}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                                <ProgressBar Grid.Row="1" Grid.Column="1" Maximum="100" Value="{x:Bind BarValue}" />
                                                <TextBlock Grid.RowSpan="2" Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind SizeText}" />
                                                <TextBlock
                                                    Grid.RowSpan="2"
                                                    Grid.Column="3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind PercentText}" />
                                                <FontIcon
                                                    Grid.RowSpan="2"
                                                    Grid.Column="4"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE76C;"
                                                    Visibility="{x:Bind CanOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!--  Biggest files  -->
                        <Border
                            Grid.Column="1"
                            Padding="4,12,4,4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="12,0" FontWeight="SemiBold" Text="Biggest files" />
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="12,4"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Files over 50 MB show up here after a scan."
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasBiggestFiles, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
                                <ListView Grid.Row="1" ItemsSource="{Binding BiggestFiles}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodel:BigFileViewModel">
                                            <Grid Padding="0,6" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Folder}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind SizeText}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Padding="6"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{x:Bind RevealCommand}"
                                                    ToolTipService.ToolTip="Show in Explorer"
                                                    AutomationProperties.Name="Show in Explorer">
                                                    <FontIcon FontSize="14" Glyph="&#xE838;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
