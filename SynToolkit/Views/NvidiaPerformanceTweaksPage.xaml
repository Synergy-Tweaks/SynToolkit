<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.NvidiaPerformanceTweaksPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:appControls="using:SynToolkit.Controls"
    xmlns:local="using:SynToolkit.Views"
    xmlns:viewmodels="using:SynToolkit.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <DataTemplate x:Key="NvidiaTweakCardTemplate" x:DataType="viewmodels:NvidiaTweakRowViewModel">
            <appControls:TweakCard
                ActionRequested="TweakCard_ActionRequested"
                Item="{x:Bind}" />
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24,8,24,24" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <InfoBar
                Grid.Row="0"
                IsOpen="{x:Bind ViewModel.ReadOnlyBarOpen, Mode=OneWay}"
                IsClosable="False"
                Severity="Warning"
                Title="Administrator access required"
                Message="SynToolkit is not running as administrator. Checks and reads still work, but write actions are disabled." />

            <InfoBar
                Grid.Row="0"
                IsOpen="{x:Bind ViewModel.ResultBarOpen, Mode=TwoWay}"
                IsClosable="True"
                Margin="0,42,0,0"
                Severity="{x:Bind ViewModel.ResultSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.ResultTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}" />

            <Border
                Grid.Row="1"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.ActiveGpuName, Mode=OneWay}" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ViewModel.DriverClassPath, Mode=OneWay}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Driver key selected by INF match"
                            Visibility="{x:Bind ViewModel.DriverClassMatchedByInf, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        <Border
                            Padding="8,3"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4"
                            Visibility="{x:Bind ViewModel.HasRestartPending, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Text="Restart required for active driver state" />
                        </Border>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            Text="Applied" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            Click="CheckAllButton_Click"
                            Content="Check all" />
                        <Button
                            Click="VerifyButton_Click"
                            Content="Verify" />
                        <Button
                            Click="ExportRegButton_Click"
                            Content="Export applied .reg" />
                        <Button
                            Click="RestoreOriginalsButton_Click"
                            Content="Restore all originals" />
                        <ProgressRing
                            Width="18"
                            Height="18"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,2,0,2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    PlaceholderText="Search tweak, description, or registry target"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    Grid.Column="1"
                    SelectedIndex="{x:Bind FilterIndex, Mode=TwoWay}">
                    <x:String>All</x:String>
                    <x:String>Applied</x:String>
                    <x:String>Not applied</x:String>
                    <x:String>Different</x:String>
                </ComboBox>
            </Grid>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <StackPanel Visibility="{x:Bind ViewModel.HasNvidiaGpu, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:NvidiaTweakGroupViewModel">
                                    <Expander Margin="0,0,0,10" IsExpanded="True">
                                <Expander.Header>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Header}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind CountLabel}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Click="ApplyGroupButton_Click"
                                                Content="Apply group"
                                                Tag="{x:Bind Group}" />
                                            <Button
                                                Click="RevertGroupButton_Click"
                                                Content="Revert group"
                                                Tag="{x:Bind Group}" />
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <ItemsRepeater Margin="0,10,0,2" ItemTemplate="{StaticResource NvidiaTweakCardTemplate}" ItemsSource="{x:Bind VisibleRows}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsStretch="Fill"
                                            MinColumnSpacing="12"
                                            MinItemWidth="420"
                                            MinRowSpacing="12" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <InfoBar
                        IsOpen="{x:Bind ViewModel.ShowNoNvidiaMessage, Mode=OneWay}"
                        IsClosable="False"
                        Margin="0,8,0,0"
                        Severity="Informational"
                        Title="NVIDIA GPU not found"
                        Message="{x:Bind ViewModel.NoNvidiaMessage, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
    </Grid>
</Page>
