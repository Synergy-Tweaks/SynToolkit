<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="SynToolkit.Views.PowerPlanSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FullSizeDesired="True"
    Opened="Dialog_Opened"
    Closed="Dialog_Closed">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <x:Double x:Key="ContentDialogMaxWidth">1020</x:Double>
            <x:Double x:Key="ContentDialogMaxHeight">860</x:Double>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <Grid x:Name="DialogContent" Width="900" Height="620" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="36">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Power settings" />
            <Button
                Width="32"
                Height="32"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="Close power settings"
                Background="Transparent"
                BorderThickness="0"
                Click="CloseViewerButton_Click"
                Padding="0"
                ToolTipService.ToolTip="Close power settings">
                <FontIcon FontSize="12" Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <TextBlock
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Inspect every setting in a .pow file before activating it."
            TextWrapping="Wrap" />

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="PlanPicker"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                DisplayMemberPath="DisplayName"
                Header="Power plan"
                PlaceholderText="Choose a bundled plan"
                SelectionChanged="PlanPicker_SelectionChanged" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Click="BrowsePowButton_Click"
                Content="Choose .pow file"
                ToolTipService.ToolTip="Inspect a power plan stored elsewhere on your computer" />
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleSwitch
                x:Name="CompareToggle"
                Grid.Column="0"
                Header="Compare with current plan"
                Toggled="CompareToggle_Toggled" />
            <CheckBox
                x:Name="DifferencesOnlyBox"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Content="Differences only"
                Checked="DifferencesOnlyBox_Changed"
                Unchecked="DifferencesOnlyBox_Changed"
                Visibility="Collapsed" />
        </Grid>

        <TextBox
            x:Name="SettingsSearchBox"
            Grid.Row="4"
            AutomationProperties.Name="Search power settings"
            PlaceholderText="Search setting, category, description, or GUID"
            TextChanged="SettingsSearchBox_TextChanged" />

        <Grid Grid.Row="5" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="ResultsText"
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Choose a plan to inspect." />
            <ProgressRing
                x:Name="LoadingRing"
                Grid.Column="1"
                Width="18"
                Height="18"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="6">
            <InfoBar
                x:Name="ReadErrorBar"
                VerticalAlignment="Top"
                IsClosable="True"
                IsOpen="False"
                Severity="Error"
                Title="Could not read this plan" />

            <TextBlock
                x:Name="EmptyMessage"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Choose a plan to inspect."
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Grid x:Name="SettingsPane" Visibility="Collapsed" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="8,0,0,0"
                        FontWeight="SemiBold"
                        Text="Categories" />
                    <ListView
                        x:Name="CategoryList"
                        Grid.Row="1"
                        AutomationProperties.Name="Power setting categories"
                        HorizontalAlignment="Stretch"
                        SelectionMode="Single"
                        SelectionChanged="CategoryList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{Binding Name}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Count}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <TextBlock
                    x:Name="NoResultsMessage"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No settings match. Try another category or search term."
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="1">
                <StackPanel>
                    <Grid Padding="8,0,8,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Setting" />
                        <TextBlock
                            x:Name="CurrentColumnHeader"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="Current plan"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="SelectedColumnHeader"
                            Grid.Column="2"
                            FontWeight="SemiBold"
                            Text="Plan value" />
                    </Grid>
                    <ItemsControl x:Name="SettingsGroupsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <StackPanel Margin="8,8,8,6" Orientation="Horizontal" Spacing="10">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding CountLabel}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="8,9"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="150" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Text="{Binding Name}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTipService.ToolTip="{Binding SettingId}" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                                                FontSize="12"
                                                                Text="Changed"
                                                                Visibility="{Binding DifferenceVisibility}" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            FontSize="12"
                                                            MaxLines="2"
                                                            Text="{Binding Description}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Spacing="2"
                                                        Visibility="{Binding CurrentVisibility}">
                                                        <TextBlock
                                                            Text="{Binding CurrentAcLabel}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTipService.ToolTip="{Binding CurrentAcLabel}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding CurrentDcLabel}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTipService.ToolTip="{Binding CurrentDcLabel}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Spacing="2">
                                                        <TextBlock
                                                            Text="{Binding SelectedAcLabel}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTipService.ToolTip="{Binding SelectedAcLabel}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding SelectedDcLabel}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTipService.ToolTip="{Binding SelectedDcLabel}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
