<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SynToolkit.Views.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:SynToolkit.Controls"
    xmlns:local="using:SynToolkit.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:BoolToVisibilityInverseConverter x:Key="InverseBoolToVisibility" />
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style x:Key="DisplayTileStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Content="{TemplateBinding Content}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="PointerFocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer
            x:Name="PageScroller"
            Grid.Row="0"
            Padding="24,12,24,16"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageLayout"
                HorizontalAlignment="Stretch"
                Spacing="12"
                SizeChanged="OnPageLayoutSizeChanged">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Display" />

                <InfoBar
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Rearrange your displays" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Select a display to change its settings" />
                    <Border
                        x:Name="CanvasBorder"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition x:Name="ButtonRow" Height="Auto" />
                            </Grid.RowDefinitions>
                            <Canvas
                                x:Name="DisplayCanvas"
                                Grid.Row="0"
                                SizeChanged="DisplayCanvas_SizeChanged" />
                            <Grid
                                Grid.Row="1"
                                Padding="12,8,12,10"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    AutomationProperties.Name="Apply staged arrangement"
                                    Command="{x:Bind ViewModel.ApplyStagedCommand, Mode=OneWay}"
                                    Content="Apply"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind ViewModel.IsStageActionsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="Cancel staged arrangement"
                                    Command="{x:Bind ViewModel.DiscardStagedCommand, Mode=OneWay}"
                                    Content="Cancel"
                                    Style="{StaticResource DefaultButtonStyle}"
                                    Visibility="{x:Bind ViewModel.IsStageActionsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Button
                                    Grid.Column="3"
                                    AutomationProperties.HelpText="{x:Bind ViewModel.DisabledControlsTip, Mode=OneWay}"
                                    Click="Identify_Click"
                                    Content="Identify"
                                    IsEnabled="{x:Bind ViewModel.AreControlsEnabled, Mode=OneWay}"
                                    Style="{StaticResource DefaultButtonStyle}" />
                                <Button
                                    Grid.Column="4"
                                    AutomationProperties.HelpText="{x:Bind ViewModel.MakePrimaryDisabledTip, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.MakePrimaryCommand, Mode=OneWay}"
                                    Content="Make this my main display"
                                    IsEnabled="{x:Bind ViewModel.IsMakePrimaryEnabled, Mode=OneWay}"
                                    Style="{StaticResource DefaultButtonStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel
                    Spacing="8"
                    ToolTipService.ToolTip="{x:Bind ViewModel.DisabledControlsTip, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.SelectedMonitorName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="Scale" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Changes the size of apps, text, and other items."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.ScaleEmptyMessage, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.IsScaleEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.HelpText="{x:Bind ViewModel.DisabledControlsTip, Mode=OneWay}"
                                DisplayMemberPath="Label"
                                IsEnabled="{x:Bind ViewModel.AreControlsEnabled, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.ScaleOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedScaleOption, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.IsScaleEmpty, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="Display resolution" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Adjust your resolution."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.HelpText="{x:Bind ViewModel.DisabledControlsTip, Mode=OneWay}"
                                DisplayMemberPath="Label"
                                IsEnabled="{x:Bind ViewModel.AreControlsEnabled, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.Resolutions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedResolution, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="Refresh rate" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.HelpText="{x:Bind ViewModel.DisabledControlsTip, Mode=OneWay}"
                                DisplayMemberPath="Label"
                                IsEnabled="{x:Bind ViewModel.AreControlsEnabled, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.RefreshRates, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedRefresh, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Display orientation" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.HelpText="{x:Bind ViewModel.DisabledControlsTip, Mode=OneWay}"
                                DisplayMemberPath="Label"
                                IsEnabled="{x:Bind ViewModel.AreControlsEnabled, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.OrientationOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedOrientation, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="HDR" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.HdrStatusText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.HelpText="{x:Bind ViewModel.HdrToggleTip, Mode=OneWay}"
                                AutomationProperties.Name="HDR"
                                IsEnabled="{x:Bind ViewModel.IsHdrToggleEnabled, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.IsHdrOn, Mode=TwoWay}"
                                MinWidth="0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No active displays found." />
                    <Button
                        HorizontalAlignment="Left"
                        AutomationProperties.HelpText="{x:Bind ViewModel.DisabledControlsTip, Mode=OneWay}"
                        Command="{x:Bind ViewModel.LoadCommand, Mode=OneWay}"
                        Content="Retry"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind ViewModel.IsBarVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid
                Padding="16,10"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.BarMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    AutomationProperties.HelpText="{x:Bind ViewModel.KeepDisabledTip, Mode=OneWay}"
                    Command="{x:Bind ViewModel.KeepCommand, Mode=OneWay}"
                    Content="Keep"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    Grid.Column="2"
                    AutomationProperties.HelpText="{x:Bind ViewModel.DisabledControlsTip, Mode=OneWay}"
                    Command="{x:Bind ViewModel.RevertNowCommand, Mode=OneWay}"
                    Content="Revert"
                    Style="{StaticResource DefaultButtonStyle}" />
                <TextBlock
                    Grid.Column="0"
                    Width="1"
                    Height="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.LiveSetting="Polite"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Text="{x:Bind ViewModel.AnnouncerMessage, Mode=OneWay}" />
            </Grid>
        </Border>

        <controls:ErrorOverlay Grid.RowSpan="2" />
        <controls:BusyOverlay Grid.RowSpan="2" ShowWhen="{x:Bind ViewModel.IsBusyOverlayVisible, Mode=OneWay}" />
    </Grid>
</Page>
