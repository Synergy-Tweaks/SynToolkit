<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.PowerPlansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SynToolkit.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CategoryTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,10" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="55,0,0,48">
            <TextBlock
                Margin="0,24,36,8"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Power plans" local:LocalizedText.TextKey="PowerPlansPageText2EC4CBA35614" />
            <TextBlock
                Margin="0,0,36,24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Import and manage Windows power plans directly from SynToolkit. Nothing is changed during setup." local:LocalizedText.TextKey="PowerPlansPageTextA41C747FB104"
                TextWrapping="Wrap" />

            <InfoBar
                x:Name="ElevationInfoBar"
                Margin="0,0,36,18"
                IsClosable="False"
                IsOpen="False"
                Message="Power-plan changes are disabled in this session. Restart SynToolkit as administrator to import, activate, restore, or remove plans." local:LocalizedText.MessageKey="PowerPlansPageMessage159CDB6E910C"
                Severity="Warning"
                Title="Administrator access required" local:LocalizedText.TitleKey="PowerPlansPageTitle34B02AE972E2" />

            <InfoBar
                x:Name="OperationInfoBar"
                Margin="0,0,36,18"
                IsOpen="False"
                IsClosable="True" />

            <InfoBar
                Margin="0,0,36,18"
                IsClosable="False"
                IsOpen="True"
                Message="The supplied SOS.pow settings are preserved exactly. SynToolkit imports and activates it only when you choose Import and activate, and records your current plan for recovery." local:LocalizedText.MessageKey="PowerPlansPageMessage43FB7E05A3A7"
                Severity="Informational"
                Title="Safe, explicit import" local:LocalizedText.TitleKey="PowerPlansPageTitleBC4F98976E4B" />

            <TextBlock Style="{StaticResource CategoryTitle}" Text="Status" local:LocalizedText.TextKey="PowerPlansPageText586894BC9EF1" />
            <controls:SettingsCard
                Header="Current power plan" local:LocalizedText.HeaderKey="PowerPlansPageHeader9EF26DE51104"
                Description="The plan Windows is using right now." local:LocalizedText.DescriptionKey="PowerPlansPageDescription320073B0E4BC"
                Style="{StaticResource ConfigurationSettingsCardTemplate}">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Source="ms-appx:///assets/Icons/Energy.png" />
                </controls:SettingsCard.HeaderIcon>
                <Grid MinWidth="245">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="CurrentPlanName"
                            FontWeight="SemiBold"
                            Text="Reading Windows power settings..." local:LocalizedText.TextKey="PowerPlansPageText24F29FA5EA9E"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="CurrentPlanId"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <ProgressRing
                            x:Name="StatusProgressRing"
                            Width="18"
                            Height="18"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            Content="Refresh" local:LocalizedText.ContentKey="PowerPlansPageContent7AEA1A0ACF33" />
                    </StackPanel>
                </Grid>
            </controls:SettingsCard>

            <TextBlock Style="{StaticResource CategoryTitle}" Text="Manage plans" local:LocalizedText.TextKey="PowerPlansPageTextC5BE90F1D6A5" />
            <controls:SettingsExpander
                Header="SynToolkit SOS Performance" local:LocalizedText.HeaderKey="PowerPlansPageHeaderEC2BEE95E81C"
                Description="The official SOS.pow plan, embedded securely inside SynToolkit." local:LocalizedText.DescriptionKey="PowerPlansPageDescription00DF1C96DB4F"
                Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                <controls:SettingsExpander.HeaderIcon>
                    <BitmapIcon ShowAsMonochrome="False" UriSource="/assets/logo/SynToolkit.ico" />
                </controls:SettingsExpander.HeaderIcon>
                <Border
                    Padding="10,4"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="12">
                    <TextBlock
                        x:Name="BuiltInPlanState"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Checking..." local:LocalizedText.TextKey="PowerPlansPageText938CA32A96AA" />
                </Border>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="Import and activate" local:LocalizedText.HeaderKey="PowerPlansPageHeader96571F9BC38E"
                        Description="Imports a fresh copy of SOS.pow and makes it the active Windows plan." local:LocalizedText.DescriptionKey="PowerPlansPageDescriptionC1BD75967247">
                        <Button
                            x:Name="ImportBuiltInButton"
                            Click="ImportBuiltInButton_Click"
                            Content="Import and activate" local:LocalizedText.ContentKey="PowerPlansPageContentD405C33784A6"
                            Style="{StaticResource AccentButtonStyle}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Activate existing plan" local:LocalizedText.HeaderKey="PowerPlansPageHeaderBBFA1C9D07DB"
                        Description="Switches to the SynToolkit plan without importing it again." local:LocalizedText.DescriptionKey="PowerPlansPageDescription1D7E8FE3180D">
                        <Button
                            x:Name="ActivateBuiltInButton"
                            Click="ActivateBuiltInButton_Click"
                            Content="Activate" local:LocalizedText.ContentKey="PowerPlansPageContent3AED82A973BC" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Remove SynToolkit plan" local:LocalizedText.HeaderKey="PowerPlansPageHeaderF0E06FE0A377"
                        Description="Restores the previous plan when needed, then removes only SynToolkit's plan." local:LocalizedText.DescriptionKey="PowerPlansPageDescription7E9008F88BF9">
                        <Button
                            x:Name="RemoveBuiltInButton"
                            Click="RemoveBuiltInButton_Click"
                            Content="Remove" local:LocalizedText.ContentKey="PowerPlansPageContentECB59C22D98B" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsCard
                Header="Import a .pow file" local:LocalizedText.HeaderKey="PowerPlansPageHeaderDE35348C21CF"
                Description="Choose any local Windows power-plan file. SynToolkit imports it with a new ID and activates it." local:LocalizedText.DescriptionKey="PowerPlansPageDescription2589AEE1F281"
                Style="{StaticResource ConfigurationSettingsCardTemplate}">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Source="ms-appx:///assets/Icons/External.png" />
                </controls:SettingsCard.HeaderIcon>
                <Button
                    x:Name="ImportCustomButton"
                    Click="ImportCustomButton_Click"
                    Content="Choose .pow file" local:LocalizedText.ContentKey="PowerPlansPageContent3F40A12565D0" />
            </controls:SettingsCard>

            <Grid Margin="0,8,36,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Bundled power plans" local:LocalizedText.TextKey="PowerPlansPageText5AEE5ED5062B" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Pre-packaged power plans from the community. Select one to import and activate it." local:LocalizedText.TextKey="PowerPlansPageText8B0EFF361274" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="RefreshBundledPlansButton"
                        Click="RefreshBundledPlansButton_Click"
                        Content="Refresh" local:LocalizedText.ContentKey="PowerPlansPageContent7AEA1A0ACF33" />
                    <Button
                        x:Name="ListViewButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="ListViewButton_Click"
                        ToolTipService.ToolTip="List view">
                        <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                    </Button>
                    <Button
                        x:Name="GridViewButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="GridViewButton_Click"
                        ToolTipService.ToolTip="Grid view">
                        <FontIcon FontSize="14" Glyph="&#xE8A9;" />
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock
                Margin="0,0,36,12"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                <Run Text="Want to create your own?" />
                <Hyperlink NavigateUri="https://www.youtube.com/watch?v=GJ3omzm-CYU">Watch the tutorial →</Hyperlink>
            </TextBlock>

            <StackPanel
                x:Name="BundledPlansEmptyState"
                Margin="0,0,36,18"
                Visibility="Collapsed">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="No bundled power plans found. The Assets\PowerPlans folder may be missing." local:LocalizedText.TextKey="PowerPlansPageText0920E57AFDEA"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- List View (default) -->
            <ItemsControl
                x:Name="BundledPlansListView"
                Margin="0,0,36,18">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:SettingsCard
                            Header="{Binding DisplayName}"
                            Description="{Binding Description}"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <controls:SettingsCard.HeaderIcon>
                                <ImageIcon Source="ms-appx:///assets/Icons/Energy.png" />
                            </controls:SettingsCard.HeaderIcon>
                            <Button
                                Click="ImportBundledPlanButton_Click"
                                Content="Import and activate" local:LocalizedText.ContentKey="PowerPlansPageContentD405C33784A6"
                                Tag="{Binding}" />
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Grid View -->
            <ItemsControl
                x:Name="BundledPlansGridView"
                Margin="0,0,36,18"
                Visibility="Collapsed">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            ItemWidth="280"
                            MaximumRowsOrColumns="4"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,8,8"
                            Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ImageIcon
                                        Width="20"
                                        Height="20"
                                        Source="ms-appx:///assets/Icons/Energy.png" />
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,6,0,10"
                                    MaxLines="2"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    ToolTipService.ToolTip="{Binding Description}" />
                                <Button
                                    Grid.Row="2"
                                    HorizontalAlignment="Stretch"
                                    Click="ImportBundledPlanButton_Click"
                                    Content="Import and activate" local:LocalizedText.ContentKey="PowerPlansPageContentD405C33784A6"
                                    Tag="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <controls:SettingsExpander
                Header="Recovery" local:LocalizedText.HeaderKey="PowerPlansPageHeader3F93D5248728"
                Description="Return to the plan you were using before, or select Windows Balanced." local:LocalizedText.DescriptionKey="PowerPlansPageDescriptionCF5ED4E3758A"
                Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                <controls:SettingsExpander.HeaderIcon>
                    <ImageIcon Source="ms-appx:///assets/Icons/Update.png" />
                </controls:SettingsExpander.HeaderIcon>
                <TextBlock
                    x:Name="PreviousPlanState"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No previous plan has been recorded." local:LocalizedText.TextKey="PowerPlansPageText49DC49CF4885"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="Restore previous plan" local:LocalizedText.HeaderKey="PowerPlansPageHeader89FC59E6657A"
                        Description="Returns to the plan that was active before the last SynToolkit import or activation." local:LocalizedText.DescriptionKey="PowerPlansPageDescription5C7E9ABF6892">
                        <Button
                            x:Name="RestorePreviousButton"
                            Click="RestorePreviousButton_Click"
                            Content="Restore" local:LocalizedText.ContentKey="PowerPlansPageContent772D7B9C2CDC" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Windows Balanced" local:LocalizedText.HeaderKey="PowerPlansPageHeader9C530FD0F4A6"
                        Description="Activates the standard Windows Balanced plan." local:LocalizedText.DescriptionKey="PowerPlansPageDescription4F78D5A8D023">
                        <Button
                            x:Name="ActivateBalancedButton"
                            Click="ActivateBalancedButton_Click"
                            Content="Activate Balanced" local:LocalizedText.ContentKey="PowerPlansPageContent8783830A1560" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Windows power settings" local:LocalizedText.HeaderKey="PowerPlansPageHeaderD277261A7D71"
                        Description="Open the Windows Settings power and sleep page." local:LocalizedText.DescriptionKey="PowerPlansPageDescription044496606394">
                        <Button
                            Click="OpenPowerSettingsButton_Click"
                            Content="Open settings" local:LocalizedText.ContentKey="PowerPlansPageContent2D89BEEF4648" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Restore default power plans" local:LocalizedText.HeaderKey="PowerPlansPageHeader812CAC4AAD68"
                        Description="Resets every Windows power plan to its default configuration, removing SynToolkit's plan and any other custom plans. This cannot be undone." local:LocalizedText.DescriptionKey="PowerPlansPageDescription05CCD93E4D67">
                        <Button
                            x:Name="RestoreDefaultSchemesButton"
                            Click="RestoreDefaultSchemesButton_Click"
                            Content="Restore defaults" local:LocalizedText.ContentKey="PowerPlansPageContent38E36992B8A4" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</Page>
