<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:SynToolkit.Views"
    xmlns:vm="using:SynToolkit.ViewModels"
    Loaded="Page_Loaded">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="55,0,0,48">
            <Grid Margin="0,24,36,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Image
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        Source="ms-appx:///assets/Icons/Games.png" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Games"
                        local:LocalizedText.TextKey="Games" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Click="AddManualButton_Click"
                        Content="Add Game Manually"
                        local:LocalizedText.ContentKey="GamesPage_AddManual" />
                    <Button
                        Click="ScanButton_Click"
                        Content="Scan for Games"
                        local:LocalizedText.ContentKey="GamesPage_Scan"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

            <TextBlock
                Margin="0,0,36,12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Scan installed Steam, Epic, and GOG games, add titles manually, and launch them from SynToolkit."
                TextWrapping="Wrap"
                local:LocalizedText.TextKey="GamesPage_Description" />

            <Border
                Margin="0,0,36,18"
                Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="#0DFFFFFF"
                BorderThickness="1"
                CornerRadius="6">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Powered by " />
                    <Hyperlink NavigateUri="https://github.com/JosefNemec/Playnite">Playnite</Hyperlink>
                    <Run Text=" — detection logic ported from Playnite's MIT-licensed library plugins." />
                </TextBlock>
            </Border>

            <InfoBar
                Margin="0,0,36,18"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Error"
                Title="Games" />

            <Grid Margin="0,0,36,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    PlaceholderText="Search games"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    local:LocalizedText.PlaceholderTextKey="GamesPage_SearchPlaceholder" />
                <ProgressRing
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    Margin="12,0,0,0"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <TextBlock
                Margin="0,0,36,12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap" />

            <StackPanel
                Margin="0,24,36,0"
                HorizontalAlignment="Left"
                Spacing="12"
                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="No games yet"
                    local:LocalizedText.TextKey="GamesPage_EmptyTitle" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Scan for installed launcher games or add an executable manually."
                    TextWrapping="Wrap"
                    local:LocalizedText.TextKey="GamesPage_EmptyBody" />
            </StackPanel>

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="0" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameLibraryItemViewModel">
                        <controls:SettingsCard
                            Description="{x:Bind PathSummary, Mode=OneWay}"
                            Header="{x:Bind Name, Mode=OneWay}"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7FC;" />
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="11"
                                        Text="{x:Bind SourceLabel, Mode=OneWay}" />
                                </Border>
                                <Button
                                    Command="{x:Bind PlayCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="Play"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    Command="{x:Bind RemoveCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="Remove" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
